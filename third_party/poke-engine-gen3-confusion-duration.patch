+/// pokezero gen3 fidelity fix: resolve the bounded CONFUSION duration for any
+/// side whose confusion check ran this turn, forking `branch` on the hazard
+/// ladder in `chance_confusion_ends`.
+///
+/// This is the only point in the turn where a snap-out can be modelled without
+/// restructuring move generation: the branch is complete, so BOTH outcomes are
+/// terminal and can simply be pushed. Doing it at the start of the next
+/// attacking turn instead would need a snap-out branch that CONTINUES through
+/// the move, and `generate_instructions_from_move` advances exactly one
+/// surviving branch. The two placements are equivalent for everything
+/// observable — see `chance_confusion_ends`.
+///
+/// A turn only burns a confusion turn if the CHECK ran, so the ladder is gated
+/// on the `+1` duration instruction the confusion block emits — the marker is
+/// carried by both of that block's outcomes (self-hit and move-goes-through) and
+/// by nothing else, since every other write to this counter is a reset to zero.
+/// Gating on the counter's VALUE instead would be wrong: the counter persists
+/// across turns, so a Pokemon that spent the turn asleep, flinched, recharging
+/// or Taunted — none of which reach `confusion.onBeforeMove` in Showdown, all of
+/// which leave `time` untouched — would keep rolling the ladder while standing
+/// still. A fainted Pokemon is skipped too: its volatiles are cleared when it is
+/// replaced.
+///
+/// Composition with the residual deferral (residual-defer-on-faint patch): the
+/// marker rides the instruction list, NOT the residual block, so the ladder
+/// tracks the ply the confusion check actually happened on. On a ply that defers
+/// its residuals the marker is present and the ladder fires exactly once, right
+/// where it would have without the deferral; the replacement ply that re-attaches
+/// the deferred block is a bare `(Switch, None)` pair whose instruction list
+/// starts empty, so it carries no marker and cannot fire the ladder a second
+/// time. Pinned by `confusion_ladder_fires_once_when_residuals_are_deferred`.
+fn add_confusion_expiry_branches(
+    state: &mut State,
+    branch: StateInstructions,
+    instructions: &mut Vec<StateInstructions>,
+) {
+    let mut checked = [false; 2];
+    for instruction in &branch.instruction_list {
+        if let Instruction::ChangeVolatileStatusDuration(change) = instruction {
+            if change.volatile_status == PokemonVolatileStatus::CONFUSION && change.amount == 1 {
+                checked[change.side_ref as usize] = true;
+            }
+        }
+    }
+    if checked == [false, false] {
+        instructions.push(branch);
+        return;
+    }
+
+    state.apply_instructions(&branch.instruction_list);
+    let mut chances = [0.0f32; 2];
+    for (index, side_ref) in [SideReference::SideOne, SideReference::SideTwo]
+        .iter()
+        .enumerate()
+    {
+        let side = state.get_side_immutable(side_ref);
+        if checked[index]
+            && side
+                .volatile_statuses
+                .contains(&PokemonVolatileStatus::CONFUSION)
+            && side.get_active_immutable().hp > 0
+        {
+            chances[index] = chance_confusion_ends(side.volatile_status_durations.confusion);
+        }
+    }
+    state.reverse_instructions(&branch.instruction_list);
+
+    if chances == [0.0, 0.0] {
+        instructions.push(branch);
+        return;
+    }
+
+    // Independent per side: up to two 2-way forks, collapsing to an in-place
+    // rewrite whenever a side's chance is exactly 1.0 (the counter reached
+    // MAX_CONFUSION_TURNS, so Showdown's `time` is guaranteed to hit 0 next).
+    let mut pending = vec![branch];
+    for (index, side_ref) in [SideReference::SideOne, SideReference::SideTwo]
+        .iter()
+        .enumerate()
+    {
+        let chance = chances[index];
+        if chance == 0.0 {
+            continue;
         }
+        let mut next = Vec::with_capacity(pending.len() * 2);
+        for base in pending {
+            let mut expired = base.clone();
+            if chance < 1.0 {
+                let mut survived = base;
+                survived.update_percentage(1.0 - chance);
+                next.push(survived);
+                expired.update_percentage(chance);
+            }
+            state.apply_instructions(&expired.instruction_list);
+            end_confusion(state, side_ref, &mut expired);
+            state.reverse_instructions(&expired.instruction_list);
+            next.push(expired);
+        }
+        pending = next;
     }
+    instructions.extend(pending);
 }
 
