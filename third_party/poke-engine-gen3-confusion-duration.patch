+/// Drop CONFUSION from `side_ref` and zero its duration counter, maintaining the
+/// invariant the ladder relies on: `volatile_status_durations.confusion` is 0
+/// whenever the CONFUSION volatile is absent.
+fn end_confusion(state: &mut State, side_ref: &SideReference, instructions: &mut StateInstructions) {
+    let side = state.get_side(side_ref);
+    let duration = side.volatile_status_durations.confusion;
+    if duration != 0 {
+        instructions
+            .instruction_list
+            .push(Instruction::ChangeVolatileStatusDuration(
+                ChangeVolatileStatusDurationInstruction {
+                    side_ref: *side_ref,
+                    volatile_status: PokemonVolatileStatus::CONFUSION,
+                    amount: -duration,
+                },
+            ));
+        side.volatile_status_durations.confusion = 0;
+    }
+    instructions
+        .instruction_list
+        .push(Instruction::RemoveVolatileStatus(
+            RemoveVolatileStatusInstruction {
+                side_ref: *side_ref,
+                volatile_status: PokemonVolatileStatus::CONFUSION,
+            },
+        ));
+    side.volatile_statuses
+        .remove(&PokemonVolatileStatus::CONFUSION);
+}
