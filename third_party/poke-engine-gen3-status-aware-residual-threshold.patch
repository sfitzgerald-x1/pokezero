+/// How many distinct residual-lethality thresholds one boundary can carry.
+///
+/// One for the defender's pre-move state plus one per tick-bearing status the
+/// attacker's move can inflict. Gen-3 has three tick-bearing statuses, so four is
+/// an upper bound rather than a budget; `insert` drops anything beyond it, which
+/// degrades to fewer arms and never to a wrong mass.
+const MAX_RESIDUAL_THRESHOLDS: usize = 4;
+
+/// An ascending, de-duplicated set of residual-lethality thresholds.
+///
+/// A fixed array rather than a `Vec`: this sits on the damage-branch path, which
+/// runs once per ply per legal move.
+#[derive(Clone, Copy)]
+struct ResidualThresholdLadder {
+    values: [i16; MAX_RESIDUAL_THRESHOLDS],
+    len: usize,
+}
+
+impl ResidualThresholdLadder {
+    fn new() -> Self {
+        ResidualThresholdLadder {
+            values: [0; MAX_RESIDUAL_THRESHOLDS],
+            len: 0,
+        }
+    }
+
+    fn insert(&mut self, value: i16) {
+        if self.len == MAX_RESIDUAL_THRESHOLDS || self.values[..self.len].contains(&value) {
+            return;
+        }
+        let mut index = self.len;
+        while index > 0 && self.values[index - 1] > value {
+            self.values[index] = self.values[index - 1];
+            index -= 1;
+        }
+        self.values[index] = value;
+        self.len += 1;
+    }
+
+    fn as_slice(&self) -> &[i16] {
+        &self.values[..self.len]
+    }
+}
+
+/// Every residual-lethality threshold the defender can face THIS turn: the one
+/// its pre-move state implies, plus one per tick-bearing status the attacker's
+/// own move can inflict on it.
+///
+/// WHY. `residual_lethality_threshold` reads the defender's PRE-MOVE state, so a
+/// Fire move's own burn is invisible to it and the split never fires. Holdout
+/// rows `19100107/135` (Sacred Fire into Roselia 175/254 Leftovers) and
+/// `19100191/5` (Fire Blast into Ninjask 225/225 Leftovers): both defenders are
+/// unstatused, the mirror declines, and the whole non-crit fan collapses onto a
+/// surviving representative -- while the observed roll is a member of the
+/// engine's own fan and dies to the burn tick. With BURN visible the thresholds
+/// are 159 and 211, both inside their fans. reports/c135 sections 2-3.
+///
+/// THE UNION, NOT THE MINIMUM. A status only ADDS a tick, so every status-aware
+/// threshold is at or below the pre-move one and the two are nested. Collapsing
+/// them with `min` is a measured regression, not a simplification: when the
+/// defender already carries a non-status residual the minimum can fall BELOW the
+/// fan's lowest roll, every `min_roll < threshold` guard stops firing, and an arm
+/// the engine emits today vanishes. reports/c133 section 4 works the case
+/// through (pre-move 160, min-over-statuses 129, fan floor 144).
+fn residual_lethality_thresholds(
+    state: &State,
+    attacking_side: &SideReference,
+    choice: &Choice,
+) -> ResidualThresholdLadder {
+    let defending_side = attacking_side.get_other_side();
+    let mut ladder = ResidualThresholdLadder::new();
+    if let Some(threshold) = residual_lethality_threshold(state, &defending_side, None) {
+        ladder.insert(threshold);
+    }
+    if let Some(status) = &choice.status {
+        if status.target == MoveTarget::Opponent {
+            insert_status_aware_threshold(state, &defending_side, &status.status, &mut ladder);
+        }
+    }
+    if let Some(secondaries) = &choice.secondaries {
+        for secondary in secondaries {
+            if secondary.chance <= 0.0 || secondary.target != MoveTarget::Opponent {
+                continue;
+            }
+            if let Effect::Status(status) = &secondary.effect {
+                insert_status_aware_threshold(state, &defending_side, status, &mut ladder);
+            }
+        }
+    }
+    ladder
+}
+
+/// Add the threshold the defender would face if `status` landed on it.
+///
+/// Only BURN, POISON and TOXIC have an end-of-turn tick, so no other status can
+/// move the threshold -- the rest would dedup straight back onto the pre-move
+/// value. `immune_to_status` is the SHIPPED predicate the secondary itself will
+/// consult, so a threshold is never priced for a status this defender cannot be
+/// given (already statused, Substitute, Safeguard, Fire-type versus burn, ...).
+fn insert_status_aware_threshold(
+    state: &State,
+    defending_side: &SideReference,
+    status: &PokemonStatus,
+    ladder: &mut ResidualThresholdLadder,
+) {
+    if !matches!(
+        status,
+        PokemonStatus::BURN | PokemonStatus::POISON | PokemonStatus::TOXIC
+    ) {
+        return;
+    }
+    if immune_to_status(state, &MoveTarget::Opponent, defending_side, status) {
+        return;
+    }
+    if let Some(threshold) = residual_lethality_threshold(state, defending_side, Some(*status)) {
+        ladder.insert(threshold);
+    }
+}
