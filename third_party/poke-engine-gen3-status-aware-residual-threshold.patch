+/// One fan's residual arms, as DISJOINT bands.
+struct ResidualBands {
+    /// The representative for the rolls below the lowest applied threshold --
+    /// the engine's existing `average_surviving_damage` convention.
+    survive_representative: i16,
+    /// `(threshold, roll count)`, ascending by threshold. Each arm is priced at
+    /// its OWN threshold.
+    bands: [(i16, i16); MAX_RESIDUAL_THRESHOLDS],
+    len: usize,
+    /// The rolls covered by `bands`, i.e. everything from the lowest applied
+    /// threshold up to (but not including) the ceiling.
+    total_rolls: i16,
+}
+
+impl ResidualBands {
+    fn iter(&self) -> impl Iterator<Item = &(i16, i16)> {
+        self.bands[..self.len].iter()
+    }
+}
+
+/// Partition a fan into disjoint residual bands, one per distinct threshold.
+///
+/// `max_damage` is the comparator's basis and `min_roll` its lowest rung -- the
+/// guard that keeps `num_less_than >= 1` inside
+/// `compare_health_with_damage_multiples`, whose `0/0` is otherwise reachable.
+/// `ceiling` is the exclusive top of the residual region: the defender's HP at a
+/// site that already emits a hit-KO arm, `i16::MAX` where the fan cannot kill on
+/// the hit. `rolls_at_or_above_ceiling` is the count that KO arm already owns.
+///
+/// Arm `i` carries `#{rolls in [t_i, t_i+1)}`, the top arm `#{rolls >= t_k}`
+/// bounded by the ceiling, and the survive arm keeps `#{rolls < t_1}`. NOT
+/// `#{rolls >= t_i}` per arm: the thresholds are nested, so that recipe counts
+/// every roll above the higher threshold twice. Measured on a 170-max fan with
+/// thresholds 145 and 169, it sums to 17/16 and
+/// `update_percentage(1 - branch_chance - residual_kill_chance)` has no room for
+/// the excess. reports/c133 section 4.
+///
+/// This is a GENERALISATION of a subtraction the engine already performed:
+/// `num_at_or_above - num_kill_rolls` at the Case A site is exactly the band
+/// between the residual threshold and the KO threshold. With a one-entry ladder
+/// every site below reduces to the arithmetic it ran before.
+///
+/// A threshold at or below `min_roll` is SKIPPED rather than clamped: no roll
+/// lies below it, so it has no survive side, and skipping it leaves the higher
+/// thresholds -- and the arms the engine emits today -- untouched. That is the
+/// property `min` destroys.
+///
+/// Returns `Some` whenever ANY threshold passed the guards, even when every band
+/// turns out empty. `total_rolls == 0` is a real state -- the f32 comparator can
+/// report zero rolls at or above a threshold that is inside the integer fan
+/// (C116 M5, still open) -- and the three sites that previously gated on
+/// `n > 0` still do, so their behaviour on that path is unchanged. Collapsing it
+/// into `None` here would have changed the crit-fan site's representative from
+/// `average_surviving_crit` to `0.925 * max_crit`.
+fn residual_disjoint_bands(
+    max_damage: i16,
+    min_roll: i16,
+    thresholds: &[i16],
+    ceiling: i16,
+    rolls_at_or_above_ceiling: i16,
+) -> Option<ResidualBands> {
+    let mut applicable = [0i16; MAX_RESIDUAL_THRESHOLDS];
+    let mut applicable_len = 0usize;
+    for threshold in thresholds {
+        if *threshold > 0
+            && *threshold < ceiling
+            && max_damage >= *threshold
+            && min_roll < *threshold
+        {
+            applicable[applicable_len] = *threshold;
+            applicable_len += 1;
+        }
+    }
+    if applicable_len == 0 {
+        return None;
+    }
+
+    let mut result = ResidualBands {
+        survive_representative: 0,
+        bands: [(0, 0); MAX_RESIDUAL_THRESHOLDS],
+        len: 0,
+        total_rolls: 0,
+    };
+    // Walk DOWN the ladder so each band can subtract the population already
+    // claimed by everything above it.
+    let mut claimed_above = rolls_at_or_above_ceiling;
+    let mut index = applicable_len;
+    while index > 0 {
+        index -= 1;
+        let threshold = applicable[index];
+        let (average_below, at_or_above) =
+            compare_health_with_damage_multiples(max_damage, threshold);
+        let band = at_or_above - claimed_above;
+        if band > 0 {
+            result.bands[result.len] = (threshold, band);
+            result.len += 1;
+            result.total_rolls += band;
+        }
+        claimed_above = at_or_above;
+        if index == 0 {
+            result.survive_representative = average_below;
+        }
+    }
+    result.bands[..result.len].reverse();
+    Some(result)
 }
 
