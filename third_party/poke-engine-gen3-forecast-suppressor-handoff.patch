+    // Gen 3 Air Lock / Cloud Nine fire Forecast's WeatherChange handler when
+    // the holder LEAVES, while an incoming suppressor does not fire it on
+    // entry. Evaluate that departure while the outgoing Pokemon is still the
+    // active slot, but temporarily exclude only its ending ability. This keeps
+    // a suppressor-to-suppressor handoff faithful: Castform observes the
+    // underlying weather before the replacement becomes active and stays in
+    // that form after the incoming suppressor arrives.
+    if outgoing_suppressed_weather {
+        let outgoing_ability = state
+            .get_side_immutable(&switching_side_ref)
+            .get_active_immutable()
+            .ability;
+        state
+            .get_side(&switching_side_ref)
+            .get_active()
+            .ability = Abilities::NONE;
+        update_forecast(state, incoming_instructions);
+        state
+            .get_side(&switching_side_ref)
+            .get_active()
+            .ability = outgoing_ability;
+    }
