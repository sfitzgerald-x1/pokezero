+/// C116 Phase 2 spike -- enumerate-then-merge, OFF BY DEFAULT.
+///
+/// Read once from `POKEZERO_ENUMERATE_ROLLS` (accepts `1`/`true`). A *runtime*
+/// flag, not a cargo feature, deliberately: the decision record needs the two
+/// engines swept from ONE build so the comparison is single-variable
+/// (C119 obligation 4).
+static ENUMERATE_DAMAGE_ROLLS: std::sync::OnceLock<bool> = std::sync::OnceLock::new();
+
+pub fn enumerate_damage_rolls() -> bool {
+    *ENUMERATE_DAMAGE_ROLLS.get_or_init(|| {
+        matches!(
+            std::env::var("POKEZERO_ENUMERATE_ROLLS").as_deref(),
+            Ok("1") | Ok("true") | Ok("TRUE") | Ok("yes")
+        )
+    })
+}
