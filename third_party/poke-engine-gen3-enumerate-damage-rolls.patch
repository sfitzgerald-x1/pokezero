+/// The 16 gen3 damage rolls of a fan, in EXACT INTEGER arithmetic, pre-merged on
+/// equal damage.
+///
+/// Showdown's randomizer is `tr(tr(base * (100 - random(16))) / 100)`, i.e.
+/// `floor(max * r / 100)` for `r` in `85..=100`
+/// (`src/pokezero/gen3_damage.py:392-396` reconstructs the same expression from
+/// the protocol side and shares no arithmetic with this file). The expression
+/// used here is character-for-character the one the ALREADY-SHIPPED 32-arm
+/// enumeration for `pending_hp_reading_move` uses in this same function
+/// (`(raw_damage as i32 * random / 100) as i16`), so the spike generalizes a
+/// mechanism this engine already runs in production rather than inventing one.
+///
+/// This is what replaces `compare_health_with_damage_multiples`: its f32
+/// accumulator (`max*0.85` stepped by `max*0.01`, sixteen times) drifts below
+/// the true rung and mis-counts kill rolls for 195 `(max, threshold)` pairs in
+/// the audited range -- C116 M5. Counting enumerated integers cannot drift.
+///
+/// Rolls that collapse onto the same integer (small `max`) are merged here, so a
+/// 20-damage fan costs the 5 or 6 arms it actually has, not 16.
+fn push_enumerated_rolls(arms: &mut Vec<(i16, f32)>, max_damage: i16, mass_per_roll: f32) {
+    for numerator in 85..=100i32 {
+        let rolled = (max_damage as i32 * numerator / 100) as i16;
+        match arms.iter_mut().find(|(damage, _)| *damage == rolled) {
+            Some(existing) => existing.1 += mass_per_roll,
+            None => arms.push((rolled, mass_per_roll)),
+        }
     }
 }
 
