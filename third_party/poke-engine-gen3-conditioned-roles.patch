+    #[test]
+    fn untouched_bench_context_is_retained_without_changing_the_law() {
+        for replacing in 0..2 {
+            let (plain, capsule) = fixture(replacing);
+            let reference = resume(&plain, &capsule, PokemonIndex::P1, [0, 1]).unwrap();
+            let mut state = plain.clone();
+            for side in [&SideReference::SideOne, &SideReference::SideTwo] {
+                let bench = &mut state.get_side(side).pokemon[PokemonIndex::P2];
+                bench.ability = Abilities::EFFECTSPORE;
+                bench.base_ability = Abilities::TRACE;
+                bench.item = Items::CHOICEBAND;
+                bench.status = PokemonStatus::POISON;
+            }
+            let before = state.serialize();
+            let out = resume(&state, &capsule, PokemonIndex::P1, [0, 1]).unwrap();
+            assert_eq!(out.len(), reference.len());
+            for (actual, expected) in out.iter().zip(reference.iter()) {
+                assert_eq!(actual.percentage, expected.percentage);
+                assert_eq!(actual.capsule, expected.capsule);
+                for side in [&SideReference::SideOne, &SideReference::SideTwo] {
+                    assert_eq!(
+                        actual
+                            .state
+                            .get_side_immutable(side)
+                            .get_active_immutable()
+                            .serialize(),
+                        expected
+                            .state
+                            .get_side_immutable(side)
+                            .get_active_immutable()
+                            .serialize()
+                    );
+                    assert_eq!(
+                        actual.state.get_side_immutable(side).pokemon[PokemonIndex::P2].serialize(),
+                        state.get_side_immutable(side).pokemon[PokemonIndex::P2].serialize()
+                    );
+                }
+            }
+            assert_eq!(state.serialize(), before);
+        }
+    }
