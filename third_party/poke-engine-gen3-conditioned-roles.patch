+    #[test]
+    fn reached_entry_and_attack_abilities_still_refuse_before_generation() {
+        for replacing in 0..2 {
+            let (plain, capsule) = fixture(replacing);
+            let pivot = if replacing == 0 {
+                SideReference::SideOne
+            } else {
+                SideReference::SideTwo
+            };
+            let waiter = if replacing == 0 {
+                SideReference::SideTwo
+            } else {
+                SideReference::SideOne
+            };
+            for entrant in [false, true] {
+                for ability in [
+                    Abilities::HUSTLE,
+                    Abilities::SERENEGRACE,
+                    Abilities::EFFECTSPORE,
+                ] {
+                    let mut state = plain.clone();
+                    let target = if entrant {
+                        &mut state.get_side(&pivot).pokemon[PokemonIndex::P1]
+                    } else {
+                        state.get_side(&waiter).get_active()
+                    };
+                    target.ability = ability;
+                    target.base_ability = ability;
+                    let before = state.serialize();
+                    assert_eq!(
+                        resume(&state, &capsule, PokemonIndex::P1, [0, 1]).unwrap_err(),
+                        "UNSUPPORTED_PARTY_CONTEXT"
+                    );
+                    assert_eq!(state.serialize(), before);
+                }
+            }
+        }
+    }
