+    #[test]
+    fn nonzero_outgoing_and_replacement_indices_reclassify_each_hazard_request() {
+        for replacing in 0..2 {
+            let (mut state, capsule) = fixture(replacing);
+            let pivot = if replacing == 0 {
+                SideReference::SideOne
+            } else {
+                SideReference::SideTwo
+            };
+            let side = state.get_side(&pivot);
+            let carrier = side.pokemon[PokemonIndex::P0].clone();
+            side.pokemon[PokemonIndex::P0] = side.pokemon[PokemonIndex::P3].clone();
+            side.pokemon[PokemonIndex::P3] = carrier;
+            side.active_index = PokemonIndex::P3;
+            side.pokemon[PokemonIndex::P3].ability = Abilities::SWARM;
+            side.pokemon[PokemonIndex::P3].base_ability = Abilities::SWARM;
+            side.pokemon[PokemonIndex::P0].ability = Abilities::HUSTLE;
+            side.pokemon[PokemonIndex::P0].base_ability = Abilities::HUSTLE;
+            side.pokemon[PokemonIndex::P0].item = Items::CHOICEBAND;
+            side.pokemon[PokemonIndex::P4] = side.pokemon[PokemonIndex::P1].clone();
+            side.pokemon[PokemonIndex::P4].hp = 1;
+            side.pokemon[PokemonIndex::P2].speed = 200;
+            side.side_conditions.spikes = 1;
+            let before = state.serialize();
+            let first = resume(&state, &capsule, PokemonIndex::P4, [0, 1])
+                .unwrap()
+                .remove(0);
+            assert_eq!(state.serialize(), before);
+            assert_eq!(
+                first.state.get_side_immutable(&pivot).active_index,
+                PokemonIndex::P4
+            );
+            assert!(first.capsule.pending_residual);
+            assert_eq!(first.capsule.replacement_count, 1);
+            assert_eq!(first.capsule.queued_actor, -1);
+            let next_before = first.state.serialize();
+            let next = resume(&first.state, &first.capsule, PokemonIndex::P2, [1, 0])
+                .unwrap()
+                .remove(0);
+            assert_eq!(first.state.serialize(), next_before);
+            assert_eq!(
+                next.state.get_side_immutable(&pivot).active_index,
+                PokemonIndex::P2
+            );
+            assert!(!next.capsule.pending_residual);
+            assert_eq!(next.capsule.keys, capsule.keys);
+            let retained = &next.state.get_side_immutable(&pivot).pokemon[PokemonIndex::P0];
+            assert_eq!(retained.ability, Abilities::HUSTLE);
+            assert_eq!(retained.item, Items::CHOICEBAND);
+            assert_eq!(
+                next.state.get_side_immutable(&pivot).pokemon[PokemonIndex::P3].ability,
+                Abilities::SWARM
+            );
+        }
