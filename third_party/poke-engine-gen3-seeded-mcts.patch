+fn assert_same_mcts_result(left: &MctsResult, right: &MctsResult) {
+    assert_eq!(left.iteration_count, right.iteration_count);
+    assert_eq!(left.s1.len(), right.s1.len());
+    assert_eq!(left.s2.len(), right.s2.len());
+    for (left_node, right_node) in left.s1.iter().zip(right.s1.iter()) {
+        assert_eq!(left_node.move_choice, right_node.move_choice);
+        assert_eq!(left_node.visits, right_node.visits);
+        assert_eq!(left_node.total_score.to_bits(), right_node.total_score.to_bits());
+    }
+    for (left_node, right_node) in left.s2.iter().zip(right.s2.iter()) {
+        assert_eq!(left_node.move_choice, right_node.move_choice);
+        assert_eq!(left_node.visits, right_node.visits);
+        assert_eq!(left_node.total_score.to_bits(), right_node.total_score.to_bits());
+    }
+}
