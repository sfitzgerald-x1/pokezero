+#[test]
+fn foulplay_seeded_mcts_repeats_exactly() {
+    let search = |seed| {
+        let mut state = State::deserialize(FOULPLAY_INVALIDWEIGHT_WITNESS);
+        let (side_one_options, side_two_options) = state.get_all_options();
+        perform_mcts_seeded(
+            &mut state,
+            side_one_options,
+            side_two_options,
+            Duration::from_secs(1),
+            10_001,
+            seed,
+        )
+    };
+    let first = search(109_200_600);
+    let second = search(109_200_600);
+    assert_eq!(first.iteration_count, 10_001);
+    assert_same_mcts_result(&first, &second);
+}
