+//! Fixed-chance ordinary move requests, distinct from suspended continuation.
+//!
+//! Domain admission and chance observations come from native consumers. The
+//! parent is immutable, the address is supplied before execution, and native
+//! control flow owns the output queue and every forwarded bank expression.
+use super::abilities::Abilities;
+use super::conditioned_resume::ResumeCapsule;
+use super::damage_calc::{calculate_damage, type_effectiveness_modifier, DamageRolls};
+use super::generate_instructions::generate_instructions_from_move_pair;
+use super::items::Items;
+use super::state::{MoveChoice, Weather};
+use crate::choices::{Choices, Effect, MoveTarget, Secondary, MOVES};
+use crate::instruction::{Instruction, StateInstructions};
+use crate::state::{PokemonMoveIndex, PokemonStatus, SideConditions, SideReference, State,
+    VolatileStatusDurations};
+
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct StepChance {
+    pub draws: [[u8; 12]; 2],
+    pub phazing: [u8; 2],
+    pub secondary: [u8; 2],
+    pub sleep_talk: [u8; 2],
+    pub entry_ties: [u8; 2],
+    pub initial_tie: u8,
+}
+
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct StepAddress {
+    pub turn: u32,
+    pub keys: [u32; 2],
+    pub next_keys: [u32; 2],
+}
+
+/// Private fields prevent ordinary callers from bypassing the admitted domain.
+#[derive(Debug, Clone)]
+pub struct ValidatedStep {
+    chance: StepChance,
+}
+
+fn seat(side: &SideReference) -> usize {
+    match side { SideReference::SideOne => 0, SideReference::SideTwo => 1 }
+}
+
+impl ValidatedStep {
+    pub(crate) fn damage_roll(&self, side: &SideReference) -> (bool, u8) {
+        let s = seat(side);
+        (self.chance.draws[s][4] == 0, self.chance.draws[s][5])
+    }
+    pub(crate) fn paralysis_probability(&self, side: &SideReference) -> f32 {
+        if self.chance.draws[seat(side)][2] < 25 { 1.0 } else { 0.0 }
+    }
+    pub(crate) fn stall_probability(&self, side: &SideReference, counter: i8) -> f32 {
+        let cut = 8 >> counter.min(3).max(0);
+        if self.chance.draws[seat(side)][8] < cut { 1.0 } else { 0.0 }
+    }
+    pub(crate) fn secondary_hits(&self, side: &SideReference, secondary: &Secondary) -> bool {
+        match (&secondary.target, &secondary.effect) {
+            (MoveTarget::User, Effect::Status(PokemonStatus::PARALYZE))
+                if secondary.chance == 100.0 / 3.0 => self.chance.phazing[seat(side)] < 20,
+            (MoveTarget::Opponent, Effect::Status(PokemonStatus::PARALYZE))
+                if secondary.chance == 10.0 || secondary.chance == 30.0 =>
+                    (self.chance.secondary[seat(side)] as f32) < secondary.chance,
+            _ => panic!("CONDITIONED_STEP_UNSUPPORTED_SECONDARY_SHAPE"),
+        }
+    }
+}
+
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct Requirement {
+    pub coordinate: String,
+    pub kind: &'static str,
+    pub argument: u8,
+}
+
+fn move_index(slot: u8) -> Result<PokemonMoveIndex, &'static str> {
+    match slot { 0 => Ok(PokemonMoveIndex::M0), 1 => Ok(PokemonMoveIndex::M1),
+        2 => Ok(PokemonMoveIndex::M2), 3 => Ok(PokemonMoveIndex::M3),
+        _ => Err("ORDINARY_MOVE_SLOT_REQUIRED") }
+}
+
+/// Positive-domain rejection is before generation. Untouched party members are
+/// retained without imposing the narrower *next-request execution* whitelist.
+pub fn requirements(state: &State, slots: [u8; 2]) -> Result<Vec<Requirement>, &'static str> {
+    if state.oracle_resume.is_some() || state.oracle_step.is_some() {
+        return Err("NESTED_CONDITIONED_STEP");
+    }
+    if state.weather.weather_type != Weather::NONE || state.trick_room.active || state.team_preview {
+        return Err("STEP_UNSUPPORTED_FIELD_CONTEXT");
+    }
+    let sides = [&state.side_one, &state.side_two];
+    let mut ids = [Choices::NONE; 2];
+    for s in 0..2 {
+        let side = sides[s];
+        if side.force_switch || side.baton_passing || side.get_active_immutable().hp <= 0 {
+            return Err("ORDINARY_LIVE_REQUEST_REQUIRED");
+        }
+        let mut conditions = side.side_conditions.clone();
+        if !(0..=3).contains(&conditions.spikes) || conditions.protect < 0 {
+            return Err("STEP_UNSUPPORTED_SIDE_CONTEXT");
+        }
+        conditions.spikes = 0;
+        conditions.protect = 0;
+        if side.shed_tailing || side.slow_uturn_move || side.force_trapped
+            || side.wish != (0, 0) || side.future_sight.0 != 0
+            || !side.volatile_statuses.is_empty() || side.substitute_health != 0
+            || side.volatile_status_durations.serialize() != VolatileStatusDurations::default().serialize()
+            || conditions.serialize() != SideConditions::default().serialize()
+            || [side.attack_boost, side.defense_boost, side.special_attack_boost,
+                side.special_defense_boost, side.speed_boost, side.accuracy_boost, side.evasion_boost]
+                .iter().any(|stage| *stage != 0)
+            || side.switch_out_move_second_saved_move != Choices::NONE
+        { return Err("STEP_UNSUPPORTED_SIDE_CONTEXT"); }
+        let active = side.get_active_immutable();
+        if !matches!(active.ability, Abilities::NONE | Abilities::STATIC | Abilities::PRESSURE | Abilities::LEVITATE)
+            || !matches!(active.item, Items::NONE | Items::LEFTOVERS)
+            || !matches!(active.status, PokemonStatus::NONE | PokemonStatus::POISON | PokemonStatus::PARALYZE)
+            || active.pre_transform.is_some() || active.rest_sleep_pending_refund != 0
+            || active.rest_turns != 0 || active.sleep_turns != 0 || active.terastallized
+        { return Err("STEP_UNSUPPORTED_ACTIVE_CONTEXT"); }
+        let mv = &active.moves[&move_index(slots[s])?];
+        if !matches!(mv.id, Choices::THUNDERBOLT | Choices::BODYSLAM | Choices::EXPLOSION
+                | Choices::BATONPASS | Choices::PROTECT | Choices::ENDURE | Choices::SPLASH)
+            || mv.disabled || mv.pp <= 0
+            || format!("{:?}", mv.choice) != format!("{:?}", MOVES.get(&mv.id).unwrap())
+        { return Err("STEP_UNSUPPORTED_SELECTED_MOVE"); }
+        ids[s] = mv.id;
+        // The old ordinary oracle can round a nonimmune max0/max1 hit to
+        // zero; the suspended fixed-roll path already applies minimum one.
+        // Do not silently repair that old oracle while claiming conditioning
+        // preserves its marginal. All supported modifiers are unchanged by
+        // these seven moves before this actor executes (new paralysis changes
+        // speed only). Preserve true immunity as an admitted zero-damage case.
+        let other = sides[1-s].get_active_immutable();
+        if type_effectiveness_modifier(&mv.choice.move_type, other) > 0.0 {
+            if let Some((regular,critical)) = calculate_damage(state,
+                &if s==0 {SideReference::SideOne} else {SideReference::SideTwo},
+                &mv.choice, DamageRolls::Max) {
+                if regular <= 1 || critical <= 1 {
+                    return Err("STEP_ORDINARY_MINIMUM_DAMAGE_REPAIR_PENDING");
+                }
+            }
+        }
+    }
+    let a = sides[0].get_active_immutable().speed;
+    let b = sides[1].get_active_immutable().speed;
+    // JAX has separate residual event ties. This domain admits no potentially
+    // tied ordering, even after a newly applied paralysis changes speed.
+    if [a, a / 4].iter().any(|x| [b, b / 4].iter().any(|y| x == y)) {
+        return Err("STEP_UNSUPPORTED_RESIDUAL_SPEED_TIE");
+    }
+    let mut result = Vec::new();
+    let mut add = |coordinate: String, kind, argument| result.push(Requirement {coordinate, kind, argument});
+    for s in 0..2 {
+        if matches!(ids[s], Choices::THUNDERBOLT | Choices::BODYSLAM | Choices::EXPLOSION) {
+            add(format!("draws.{}.4", s), "less_than", 1);
+            add(format!("draws.{}.5", s), "identity", 0);
+        }
+        if matches!(ids[s], Choices::THUNDERBOLT | Choices::BODYSLAM) {
+            add(format!("secondary.{}", s), "less_than", if ids[s] == Choices::THUNDERBOLT {10} else {30});
+        }
+        if ids[s] == Choices::BODYSLAM && sides[1-s].get_active_immutable().ability == Abilities::STATIC {
+            add(format!("phazing.{}", s), "less_than", 20);
+        }
+        // The first hit can paralyze the waiting actor before BeforeMove.
+        if sides[s].get_active_immutable().status == PokemonStatus::PARALYZE
+            || matches!(ids[1-s], Choices::THUNDERBOLT | Choices::BODYSLAM)
+            || (ids[s] == Choices::BODYSLAM && sides[1-s].get_active_immutable().ability == Abilities::STATIC)
+        { add(format!("draws.{}.2", s), "less_than", 25); }
+        if matches!(ids[s], Choices::PROTECT | Choices::ENDURE) && sides[s].side_conditions.protect > 0 {
+            add(format!("draws.{}.8", s), "less_than", 8 >> sides[s].side_conditions.protect.min(3));
+        }
+    }
+    Ok(result)
+}
+
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub enum BankOrigin { Copy(String), Constant(u8) }
+
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct BankCell {
+    pub value: u8,
+    pub origin: BankOrigin,
+}
+
+#[derive(Debug)]
+pub struct StepBranch {
+    pub percentage: f32,
+    pub instructions: StateInstructions,
+    pub state: State,
+    pub capsule: ResumeCapsule,
+    /// Canonical 24 draws, two phazing, two secondary, two sleep-talk cells.
+    pub bank: Vec<BankCell>,
+}
+
+fn bank(chance: &StepChance, pending: bool) -> Vec<BankCell> {
+    let mut out = Vec::with_capacity(30);
+    let mut add = |name: String, value| out.push(if pending {
+        BankCell { value, origin: BankOrigin::Copy(name) }
+    } else { BankCell { value: 0, origin: BankOrigin::Constant(0) } });
+    for s in 0..2 { for i in 0..12 { add(format!("draws.{}.{}", s, i), chance.draws[s][i]); } }
+    for (name, values) in [("phazing", chance.phazing), ("secondary", chance.secondary), ("sleep_talk", chance.sleep_talk)] {
+        for s in 0..2 { add(format!("{}.{}", name, s), values[s]); }
+    }
+    out
+}
+
+pub fn step(state: &State, slots: [u8; 2], chance: &StepChance, address: &StepAddress)
+    -> Result<Vec<StepBranch>, &'static str>
+{
+    requirements(state, slots)?;
+    const BOUNDS: [u8; 12] = [2,100,100,100,16,16,100,4,8,2,2,2];
+    if chance.draws.iter().any(|row| row.iter().zip(BOUNDS).any(|(v,b)| *v >= b))
+        || chance.phazing.iter().any(|v| *v >= 60) || chance.secondary.iter().any(|v| *v >= 100)
+        || chance.sleep_talk.iter().any(|v| *v >= 60) || chance.entry_ties.iter().any(|v| *v >= 2)
+        || chance.initial_tie >= 2 { return Err("INVALID_STEP_CHANCE"); }
+    let turn = address.turn.checked_add(1).ok_or("STEP_TURN_OVERFLOW")?;
+    let mut native = state.clone();
+    native.oracle_step = Some(Box::new(ValidatedStep { chance: chance.clone() }));
+    let before = native.serialize();
+    let choices = [MoveChoice::Move(move_index(slots[0])?), MoveChoice::Move(move_index(slots[1])?)];
+    let branches = generate_instructions_from_move_pair(&mut native, &choices[0], &choices[1], true);
+    if before != native.serialize() { return Err("STEP_PARENT_MUTATED"); }
+    let mut result = Vec::with_capacity(branches.len());
+    let mut mass = 0.0;
+    for instructions in branches {
+        if !instructions.percentage.is_finite() || instructions.percentage <= 0.0 {
+            return Err("STEP_INVALID_POSITIVE_MASS");
+        }
+        mass += instructions.percentage;
+        let mut successor = native.clone();
+        successor.apply_instructions(&instructions.instruction_list);
+        successor.oracle_step = None;
+        let sides = [&successor.side_one, &successor.side_two];
+        let alive = [sides[0].visible_alive_pkmn() > 0, sides[1].visible_alive_pkmn() > 0];
+        let pending = alive == [true; 2] && (sides[0].force_switch || sides[1].force_switch);
+        let mut queued_actor = -1;
+        for s in 0..2 {
+            // Exact reversible commitment, rather than a guess from final HP.
+            let marker = instructions.instruction_list.iter().rev().find_map(|i| match (s, i) {
+                (0, Instruction::SetSideOneMoveSecondSwitchOutMove(v)) => Some(v.new_choice),
+                (1, Instruction::SetSideTwoMoveSecondSwitchOutMove(v)) => Some(v.new_choice),
+                _ => None,
+            });
+            if pending && marker.is_some_and(|m| m != Choices::NONE) {
+                if queued_actor != -1 || marker != Some(state.get_side_immutable(
+                    &if s==0 {SideReference::SideOne} else {SideReference::SideTwo})
+                    .get_active_immutable().moves[&move_index(slots[s])?].id) {
+                    return Err("STEP_UNSUPPORTED_QUEUE_COMMITMENT");
+                }
+                queued_actor = s as i8;
+            }
+        }
+        let queued = pending && queued_actor >= 0;
+        let capsule = ResumeCapsule {
+            pending_residual: pending,
+            forced_switch: [sides[0].get_active_immutable().hp <= 0 && alive[0] || sides[0].baton_passing,
+                            sides[1].get_active_immutable().hp <= 0 && alive[1] || sides[1].baton_passing],
+            baton_pass: [sides[0].baton_passing && alive==[true;2], sides[1].baton_passing && alive==[true;2]],
+            queued_actor,
+            queued_actions: if queued {slots} else {[0;2]},
+            // Native stores an exponent; the suspended wire stores the next
+            // attempt's denominator (0,2,4,8), exactly as the JAX producer does.
+            queued_stall: if queued {[
+                if state.side_one.side_conditions.protect==0 {0} else {1 << state.side_one.side_conditions.protect.min(3)},
+                if state.side_two.side_conditions.protect==0 {0} else {1 << state.side_two.side_conditions.protect.min(3)},
+            ]} else {[0;2]},
+            residual_draws: if pending {chance.draws} else {[[0;12];2]},
+            phazing_draws: if pending {chance.phazing} else {[0;2]},
+            secondary_draws: if pending {chance.secondary} else {[0;2]},
+            sleep_talk_draws: if pending {chance.sleep_talk} else {[0;2]},
+            replacement_count: 0, turn, keys: address.next_keys,
+        };
+        let mut reverse = successor.clone();
+        reverse.reverse_instructions(&instructions.instruction_list);
+        if reverse.serialize() != before { return Err("STEP_REVERSE_MISMATCH"); }
+        result.push(StepBranch {percentage: instructions.percentage, instructions,
+            state: successor, capsule, bank: bank(chance,pending)});
+    }
+    if (mass-100.0).abs() > 0.0001 { return Err("STEP_MASS_NOT_ONE"); }
+    Ok(result)
+}
