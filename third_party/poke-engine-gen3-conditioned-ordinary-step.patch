+    #[test]
+    fn ordinary_pending_bank_and_exact_queue_slots_are_independent_native_outputs() {
+        for first in 0..2 {
+            let mut moves=[Choices::THUNDERBOLT;2];moves[first]=Choices::BATONPASS;
+            let (mut state,chance,address)=fixture(moves);
+            state.side_one.get_active().speed=if first==0 {301} else {101};
+            state.side_two.get_active().speed=if first==1 {301} else {101};
+            state.side_one.side_conditions.protect=2;
+            state.side_two.side_conditions.protect=1;
+            let before=state.serialize();
+            let branches=step(&state,[2,2],&chance,&address).unwrap();
+            assert_eq!(branches.len(),1);
+            let b=&branches[0];
+            assert!(b.capsule.pending_residual);
+            assert_eq!(b.capsule.queued_actor,(1-first) as i8);
+            assert_eq!(b.capsule.queued_actions,[2,2]);
+            assert_eq!(b.capsule.queued_stall,[4,2]);
+            assert_eq!(b.capsule.residual_draws,chance.draws);
+            assert_eq!(b.capsule.keys,address.next_keys);
+            assert_eq!(b.capsule.turn,8);
+            assert_eq!(b.bank.len(),30);
+            assert!(b.bank.iter().all(|cell| matches!(cell.origin,BankOrigin::Copy(_))));
+            assert_eq!(state.serialize(),before);
+            assert!(state.oracle_step.is_none());
+        }
+    }
