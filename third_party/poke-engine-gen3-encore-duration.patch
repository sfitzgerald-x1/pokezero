+/// Drop ENCORE from `side_ref` and zero its duration counter. Same invariant as
+/// `end_confusion`: `volatile_status_durations.encore` is 0 whenever the ENCORE
+/// volatile is absent, so a later Encore on that side starts at the bottom of
+/// the ladder rather than mid-way up it.
+fn end_encore(state: &mut State, side_ref: &SideReference, instructions: &mut StateInstructions) {
+    let side = state.get_side(side_ref);
+    let duration = side.volatile_status_durations.encore;
+    if duration != 0 {
+        instructions
+            .instruction_list
+            .push(Instruction::ChangeVolatileStatusDuration(
+                ChangeVolatileStatusDurationInstruction {
+                    side_ref: *side_ref,
+                    volatile_status: PokemonVolatileStatus::ENCORE,
+                    amount: -duration,
+                },
+            ));
+        side.volatile_status_durations.encore = 0;
+    }
+    instructions
+        .instruction_list
+        .push(Instruction::RemoveVolatileStatus(
+            RemoveVolatileStatusInstruction {
+                side_ref: *side_ref,
+                volatile_status: PokemonVolatileStatus::ENCORE,
+            },
+        ));
+    side.volatile_statuses
+        .remove(&PokemonVolatileStatus::ENCORE);
+}
