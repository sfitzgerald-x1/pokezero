+/// pokezero gen3 fidelity fix: resolve the bounded ENCORE duration for any side
+/// whose residual tick just landed, forking `branch` on the hazard ladder in
+/// `chance_encore_ends`. Structural twin of `add_confusion_expiry_branches`
+/// below — see that function for why an end-of-turn fork is the only place a
+/// stochastic volatile end can be modelled without restructuring move
+/// generation, and why the fork is keyed on a marker instruction rather than on
+/// the counter's value.
+///
+/// The marker here is the `+1` ENCORE duration instruction emitted by
+/// `add_end_of_turn_instructions`. It is the ONLY `+1` on this counter in gen3
+/// (upstream's encore decrement is `#[cfg]`-gated to gen5+ and never compiles
+/// in), so its presence means precisely "this ply burned a residual tick", which
+/// is the event the ladder is conditioned on. A ply whose residual block was
+/// deferred past a forced replacement emits no tick and therefore no branch.
+fn add_encore_expiry_branches(
+    state: &mut State,
+    branch: StateInstructions,
+    instructions: &mut Vec<StateInstructions>,
+) {
+    let mut ticked = [false; 2];
+    for instruction in &branch.instruction_list {
+        if let Instruction::ChangeVolatileStatusDuration(change) = instruction {
+            if change.volatile_status == PokemonVolatileStatus::ENCORE && change.amount == 1 {
+                ticked[change.side_ref as usize] = true;
+            }
+        }
+    }
+    if ticked == [false, false] {
+        instructions.push(branch);
+        return;
+    }
+
+    state.apply_instructions(&branch.instruction_list);
+    let mut chances = [0.0f32; 2];
+    for (index, side_ref) in [SideReference::SideOne, SideReference::SideTwo]
+        .iter()
+        .enumerate()
+    {
+        let side = state.get_side_immutable(side_ref);
+        if ticked[index]
+            && side
+                .volatile_statuses
+                .contains(&PokemonVolatileStatus::ENCORE)
+            && side.get_active_immutable().hp > 0
+        {
+            chances[index] = chance_encore_ends(side.volatile_status_durations.encore);
+        }
+    }
+    state.reverse_instructions(&branch.instruction_list);
+
+    if chances == [0.0, 0.0] {
+        instructions.push(branch);
+        return;
+    }
+
+    let mut pending = vec![branch];
+    for (index, side_ref) in [SideReference::SideOne, SideReference::SideTwo]
+        .iter()
+        .enumerate()
+    {
+        let chance = chances[index];
+        if chance == 0.0 {
+            continue;
+        }
+        let mut next = Vec::with_capacity(pending.len() * 2);
+        for base in pending {
+            let mut expired = base.clone();
+            if chance < 1.0 {
+                let mut survived = base;
+                survived.update_percentage(1.0 - chance);
+                next.push(survived);
+                expired.update_percentage(chance);
+            }
+            state.apply_instructions(&expired.instruction_list);
+            end_encore(state, side_ref, &mut expired);
+            state.reverse_instructions(&expired.instruction_list);
+            next.push(expired);
+        }
+        pending = next;
+    }
+    instructions.extend(pending);
+}
