+#[cfg(feature = "conditioned-oracle")]
+pub(crate) fn generate_conditioned_joint_replacement(
+    state: &mut State,
+    replacements: [PokemonIndex; 2],
+    entry_ties: [u8; 2],
+) -> Vec<StateInstructions> {
+    let sides = [SideReference::SideOne, SideReference::SideTwo];
+    let speeds = [get_effective_speed(state, &sides[0]), get_effective_speed(state, &sides[1])];
+    let first = if speeds[0] == speeds[1] { entry_ties[0] as usize }
+        else { usize::from(speeds[1] > speeds[0]) };
+    let mut instructions = StateInstructions::default();
+    for side in [first, 1-first] {
+        generate_instructions_from_switch(state, replacements[side], sides[side], &mut instructions);
+    }
+    state.apply_instructions(&instructions.instruction_list);
+    let speeds = [get_effective_speed(state, &sides[0]), get_effective_speed(state, &sides[1])];
+    let first = if speeds[0] == speeds[1] { entry_ties[1] as usize }
+        else { usize::from(speeds[1] > speeds[0]) };
+    for side in [first, 1-first] {
+        if state.side_one.visible_alive_pkmn() == 0 || state.side_two.visible_alive_pkmn() == 0 {
+            break;
+        }
+        apply_switch_entry(state, replacements[side], sides[side], &mut instructions);
+        if state.get_side_immutable(&sides[side]).get_active_immutable().hp == 0 {
+            break;
+        }
+    }
+    state.reverse_instructions(&instructions.instruction_list);
+    let mut result = vec![instructions];
+    add_end_of_turn_branches(state, &mut result);
+    result
 }
