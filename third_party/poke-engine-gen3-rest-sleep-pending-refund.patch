+#[cfg(test)]
+mod rest_sleep_pending_refund_tests {
+    use super::*;
+    use crate::instruction::{Instruction, SetSleepTurnsInstruction};
+
+    /// A Pokemon with nothing owed must serialize EXACTLY as before this field
+    /// existed, so every stored corpus row keeps round-tripping.
+    #[test]
+    fn zero_refund_is_omitted_from_serialization() {
+        let pkmn = Pokemon::default();
+        assert_eq!(pkmn.rest_sleep_pending_refund, 0);
+        assert!(!pkmn.serialize().contains("refund:"));
+        assert_eq!(Pokemon::deserialize(&pkmn.serialize()).rest_sleep_pending_refund, 0);
     }
+
+    /// The tag survives a round trip, and -- the point of tagging rather than
+    /// appending positionally -- it does so with NO pre_transform present, which is
+    /// the case where a positional field would land on index 29 and panic.
+    #[test]
+    fn refund_round_trips_without_a_pre_transform() {
+        let mut pkmn = Pokemon::default();
+        pkmn.rest_sleep_pending_refund = 2;
+        let serialized = pkmn.serialize();
+        assert!(serialized.ends_with(",refund:2"), "{}", serialized);
+        let back = Pokemon::deserialize(&serialized);
+        assert_eq!(back.rest_sleep_pending_refund, 2);
+        assert!(back.pre_transform.is_none(), "refund must not be read as a PreTransform");
+    }
+
+    /// Old rows -- written before this field existed -- must still parse.
+    #[test]
+    fn a_pre_field_serialization_still_parses() {
+        let legacy = Pokemon::default().serialize_base();
+        let back = Pokemon::deserialize(&legacy);
+        assert_eq!(back.rest_sleep_pending_refund, 0);
+        assert!(back.pre_transform.is_none());
+    }
+
+    /// apply-then-reverse must return the state bit-identical. This is the invariant
+    /// that forced an Instruction variant instead of a bare field write.
+    #[test]
+    fn apply_then_reverse_is_bit_identical() {
+        let mut state = State::default();
+        let before = state.serialize();
+        let instruction = Instruction::SetRestSleepPendingRefund(SetSleepTurnsInstruction {
+            side_ref: SideReference::SideOne,
+            pokemon_index: PokemonIndex::P0,
+            new_turns: 3,
+            previous_turns: 0,
+        });
+        state.apply_one_instruction(&instruction);
+        assert_eq!(state.side_one.pokemon[PokemonIndex::P0].rest_sleep_pending_refund, 3);
+        assert_ne!(state.serialize(), before, "apply must actually change the state");
+        state.reverse_instructions(&vec![instruction]);
+        assert_eq!(state.serialize(), before, "reverse must restore bit-identically");
+    }
 }
