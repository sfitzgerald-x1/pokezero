+
+#[test]
+fn empty_move_slots_are_not_emitted_as_legal_options() {
+    // Empty engine slots retain default PP.  They must never become phantom
+    // `Move(slot)` choices merely because the PP field is nonzero: there is no
+    // move identity or request action for a caller to execute.
+    let mut state = State::default();
+    state
+        .side_one
+        .get_active()
+        .replace_move(PokemonMoveIndex::M0, Choices::TACKLE);
+    state
+        .side_two
+        .get_active()
+        .replace_move(PokemonMoveIndex::M0, Choices::TACKLE);
+
+    let (side_one_options, side_two_options) = state.get_all_options();
+    for options in [&side_one_options, &side_two_options] {
+        assert!(options.contains(&MoveChoice::Move(PokemonMoveIndex::M0)));
+        assert!(
+            !options.iter().any(|option| {
+                matches!(
+                    option,
+                    MoveChoice::Move(PokemonMoveIndex::M1)
+                        | MoveChoice::Move(PokemonMoveIndex::M2)
+                        | MoveChoice::Move(PokemonMoveIndex::M3)
+                )
+            }),
+            "empty default slots must not be offered as moves"
+        );
+    }
