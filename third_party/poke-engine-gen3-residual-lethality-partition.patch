+/// Smallest post-move HP that SURVIVES the end-of-turn phase, so damage `d` is
+/// residual-lethal iff `hp - d < h*`, i.e. iff `d >= hp - h* + 1`. That is the
+/// threshold the fan is partitioned on.
+///
+/// `residual_phase_final_hp` is monotonic non-decreasing in its start (every
+/// mirrored step is monotonic once threshold items are excluded), so bisection is
+/// valid. Returns `None` to decline partitioning.
+fn residual_lethality_threshold(state: &State, side_ref: &SideReference) -> Option<i16> {
+    let hp = state
+        .get_side_immutable(side_ref)
+        .get_active_immutable()
+        .hp;
+    if hp <= 0 {
+        return None;
+    }
+    // If even 1 HP survives the phase, no roll can be residual-lethal. Probing at
+    // the CURRENT hp would be wrong: the 10.4 heal is min(maxhp/16, maxhp - hp),
+    // so it is LARGER after the hit than before, and a probe at current hp
+    // understates the healing available to a damaged defender.
+    if residual_phase_final_hp(state, side_ref, 1)? > 0 {
+        return None;
+    }
+    let mut low = 1;
+    let mut high = hp;
+    if residual_phase_final_hp(state, side_ref, high)? <= 0 {
+        // Even a full-HP defender dies to its own residual; every roll is lethal.
+        return Some(1);
+    }
+    while low < high {
+        let mid = low + (high - low) / 2;
+        if residual_phase_final_hp(state, side_ref, mid)? > 0 {
+            high = mid;
+        } else {
+            low = mid + 1;
+        }
+    }
+    Some(hp - low + 1)
+}
