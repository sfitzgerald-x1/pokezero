 /// maxhp/2 is paid and whether Attack goes to +6 (seed 19000073 step 1:
 /// Thunderbolt's realised roll 127 leaves Linoone at 134/261 and the drum
 /// fires, while the representative 135 leaves 126 and it correctly declines).
+/// What the END-OF-TURN phase will take off `side_ref` if it is still alive.
+///
+/// Summing is sound for the LETHALITY question specifically: every tick clamps to
+/// the HP remaining at its own point in the order, so total damage dealt is
+/// `min(hp, sum)` and the defender dies iff `hp <= sum`. It would NOT be sound if
+/// this were used for a magnitude. Registered in reports/c109.
+///
+/// Mirrors add_end_of_turn_instructions tick for tick INCLUDING its guards. A
+/// threshold from a different formula than the phase applies would move
+/// probability mass to the wrong arm silently -- worse than not partitioning.
+fn pending_residual_damage(state: &State, side_ref: &SideReference) -> i16 {
+    let side = state.get_side_immutable(side_ref);
+    let active = side.get_active_immutable();
+    if active.hp <= 0 {
+        return 0;
+    }
+    let mut total: i16 = 0;
+    if state.weather_is_active(&Weather::HAIL) {
+        if !active.has_type(&PokemonType::ICE) {
+            total += cmp::max(active.maxhp / 16, 1);
+        }
+    } else if state.weather_is_active(&Weather::SAND)
+        && !active.has_type(&PokemonType::GROUND)
+        && !active.has_type(&PokemonType::STEEL)
+        && !active.has_type(&PokemonType::ROCK)
+        && active.ability != Abilities::SANDVEIL
+    {
+        total += cmp::max(active.maxhp / 16, 1);
+    }
+    match active.status {
+        PokemonStatus::POISON => total += cmp::max(active.maxhp / 8, 1),
+        PokemonStatus::TOXIC => {
+            // Mirror the phase EXACTLY: normalize in i16 (storage is i8), then
+            // stage = normalized + 1. See `let stage = normalized_toxic_count + 1`
+            // in add_end_of_turn_instructions. `max(count, 1)` coincides with the
+            // phase only at count 0 and understates every higher ladder rung by a
+            // full stage, which puts the residual threshold in the wrong place and
+            // hands the surviving arm rolls that in fact die. Measured: at
+            // toxic_count 1 the real tick is maxhp/8, not maxhp/16.
+            let normalized = cmp::min(cmp::max(side.side_conditions.toxic_count as i16, 0), 14);
+            total += cmp::max(active.maxhp / 16, 1) * (normalized + 1);
+        }
+        _ => {}
+    }
+    if side
+        .volatile_statuses
+        .contains(&PokemonVolatileStatus::LEECHSEED)
+    {
+        total += cmp::max(active.maxhp / 8, 1);
+    }
+    cmp::min(total, active.hp)
+}
