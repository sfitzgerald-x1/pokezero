 /// maxhp/2 is paid and whether Attack goes to +6 (seed 19000073 step 1:
 /// Thunderbolt's realised roll 127 leaves Linoone at 134/261 and the drum
 /// fires, while the representative 135 leaves 126 and it correctly declines).
+/// What the END-OF-TURN phase will take off `side_ref` if it is still alive.
+///
+/// Summing is sound for the LETHALITY question specifically: every tick clamps to
+/// the HP remaining at its own point in the order, so total damage dealt is
+/// `min(hp, sum)` and the defender dies iff `hp <= sum`. It would NOT be sound if
+/// this were used for a magnitude. Registered in reports/c109.
+///
+/// Mirrors add_end_of_turn_instructions tick for tick INCLUDING its guards. A
+/// threshold from a different formula than the phase applies would move
+/// probability mass to the wrong arm silently -- worse than not partitioning.
+/// Final HP of `side_ref`'s active after the end-of-turn phase, given a
+/// hypothetical starting HP. Returns `None` when the phase contains something
+/// this mirror does not reproduce, which means "decline to partition".
+///
+/// Order is the phase's own, read from add_end_of_turn_instructions:
+///   order 7   Wish heal              min(maxhp - hp, maxhp / 2), only at wish.0 == 1
+///   order 8   weather DECREMENT then chip
+///   10.3      Rain Dish heal         min(maxhp / 16, maxhp - hp)
+///   10.4      Leftovers heal         min(maxhp / 16, maxhp - hp)
+///   10.5      Leech Seed damage      min(maxhp * 0.125, hp)
+///   10.6      status damage          brn/psn maxhp/8, tox maxhp/16 * (count + 1)
+///   10.9      partial trap damage    min(maxhp / 16.0, hp)
+///
+/// KNOWN GAPS in this mirror, recorded so the risk surface does not have to be
+/// re-derived. None fabricates a KO -- the real phase still decides life or death
+/// -- but each can misprice the threshold and so the mass split:
+///   * Future Sight (order 11) is neither simulated nor declined. It only ADDS
+///     damage, so the true threshold is strictly LOWER and this UNDER-partitions:
+///     it declines or splits too high, never inventing a residual KO.
+///   * Leech Seed at 10.5 is cross-side and speed-major. A faster ATTACKER holding
+///     LEECHSEED heals the defender before the defender's own 10.x set runs; with
+///     LIQUIDOOZE it damages instead. Only the defender's own seed is modelled.
+///   * DRYSKIN heals maxhp/8 in rain at 10.3. Dead code for gen3 randbats (Gen 4
+///     ability, absent from the pool), but it falsifies "Rain Dish is the only
+///     HP-changing ability" and goes live if the pool or generation changes.
+///
+/// Heals run BEFORE every damage tick, so a damage-only SUM puts the threshold
+/// too low. Summing is also unsound in the other direction: the order-8 chip can
+/// kill before the 10.4 heal, so a net can read "survives" for a defender that is
+/// already dead at step 8. Hence an ordered walk with each clamp applied.
+fn residual_phase_final_hp(state: &State, side_ref: &SideReference, start_hp: i16) -> Option<i16> {
+    let side = state.get_side_immutable(side_ref);
+    let active = side.get_active_immutable();
+    let maxhp = active.maxhp;
+
+    // Anything that changes HP at end of turn, or changes what the ticks are,
+    // and is not reproduced below. Declining is safe: it falls back to the
+    // unpartitioned behaviour. Over-partitioning is not -- it moves probability
+    // mass onto an arm that does not happen.
+    // DECLINE only for members that change HP at end of turn or delete a tick.
+    // Every entry here is mechanically justified against item_end_of_turn /
+    // ability_end_of_turn; nothing is denied "for completeness". Two rounds of
+    // getting this wrong cost real coverage in both directions:
+    //   * written as an ALLOW-list, it declined whenever the defender held so much
+    //     as a Choice Band (9 -> 11, reopening two rows another fix had closed);
+    //   * then it still denied Liechi/Petaya/SALAC, which only ever call
+    //     apply_boost_instruction and never touch HP -- Blaziken's Salac Berry in
+    //     19000029/51 made the mirror decline and the unpartitioned roll asserted a
+    //     sandstorm KO Showdown did not score.
+    // Breadth in a bail set is not free: each wrong entry silently gives up a split.
+    match active.item {
+        // Threshold heal at hp <= maxhp/2: the only genuinely NON-MONOTONE member,
+        // so the bisection cannot be trusted through it.
+        Items::SITRUSBERRY => return None,
+        // Cures any status, deleting the 10.6 tick outright.
+        Items::LUMBERRY => return None,
+        // Chesto is NOT denied: its arm is gated on PokemonStatus::SLEEP, and sleep
+        // has no 10.6 tick, so it cannot delete one. Shell Bell is NOT denied: it
+        // is not in item_end_of_turn at all -- it is drain on the HOLDER'S attack
+        // (item_modify_attack_being_used), inert on a defender at end of turn.
+        _ => {}
+    }
+    // Abilities were previously not consulted at all, which left a live gap: SHED
+    // SKIN cures status at 10.3, BEFORE the 10.6 tick, exactly Lum's failure mode.
+    // It is in the gen3 randbats pool (Seviper) and the phase genuinely branches on
+    // it, so no single threshold exists -- measured, the threshold was correct on
+    // only ~2/3 of the mass. Declining is the honest answer.
+    if active.ability == Abilities::SHEDSKIN {
+        return None;
+    }
+    let mut hp = start_hp;
+    if hp <= 0 {
+        return Some(0);
+    }
+
+    // order 7 -- Wish. Fires only on the resolving turn, and only when the
+    // target is damaged but alive.
+    if side.wish.0 == 1 && 0 < hp && hp < maxhp {
+        hp += cmp::min(maxhp - hp, maxhp / 2);
+    }
+
+    // order 8 -- the decrement happens FIRST, so a weather with exactly one turn
+    // left ENDS and does not chip. `weather_is_active` ignores turns_remaining,
+    // which is why consulting it alone over-counts on the expiring turn.
+    let weather_survives_upkeep = state.weather.turns_remaining != 1;
+    if weather_survives_upkeep {
+        if state.weather_is_active(&Weather::HAIL) {
+            if !active.has_type(&PokemonType::ICE) {
+                hp -= cmp::max(maxhp / 16, 1);
+            }
+        } else if state.weather_is_active(&Weather::SAND)
+            && !active.has_type(&PokemonType::GROUND)
+            && !active.has_type(&PokemonType::STEEL)
+            && !active.has_type(&PokemonType::ROCK)
+            && active.ability != Abilities::SANDVEIL
+        {
+            hp -= cmp::max(maxhp / 16, 1);
+        }
+        if hp <= 0 {
+            return Some(0);
+        }
+    }
+
+    // 10.3 -- Rain Dish.
+    if active.ability == Abilities::RAINDISH && state.weather_is_active(&Weather::RAIN) {
+        hp += cmp::min(maxhp / 16, maxhp - hp);
+    }
+
+    // 10.4 -- Leftovers. Every other end-of-turn item bailed out above.
+    if active.item == Items::LEFTOVERS && hp < maxhp {
+        hp += cmp::min(maxhp / 16, maxhp - hp);
+    }
+
+    // 10.5 -- Leech Seed.
+    if side
+        .volatile_statuses
+        .contains(&PokemonVolatileStatus::LEECHSEED)
+    {
+        hp -= cmp::min((maxhp as f32 * 0.125) as i16, hp);
+        if hp <= 0 {
+            return Some(0);
+        }
+    }
+
+    // 10.6 -- status.
+    match active.status {
+        PokemonStatus::BURN | PokemonStatus::POISON => hp -= cmp::max(maxhp / 8, 1),
+        PokemonStatus::TOXIC => {
+            let normalized = cmp::min(cmp::max(side.side_conditions.toxic_count as i16, 0), 14);
+            hp -= cmp::max(maxhp / 16, 1) * (normalized + 1);
+        }
+        _ => {}
+    }
+    if hp <= 0 {
+        return Some(0);
+    }
+
+    // 10.9 -- partial trap.
+    if side
+        .volatile_statuses
+        .contains(&PokemonVolatileStatus::PARTIALLYTRAPPED)
+    {
+        hp -= cmp::min((maxhp as f32 / 16.0) as i16, hp);
+    }
+
+    Some(cmp::max(hp, 0))
+}
