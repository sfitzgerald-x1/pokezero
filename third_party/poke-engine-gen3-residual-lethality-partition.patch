+/// What the END-OF-TURN phase will take off `side_ref` if it is still alive.
+///
+/// Used to partition a damage fan on RESIDUAL lethality, not just lethality on
+/// the hit. Summing is sound for the lethality question specifically: each tick
+/// is clamped to the HP remaining at its own point in the order, so total damage
+/// dealt is `min(hp, sum)` and the defender dies iff `hp <= sum`.
+///
+/// Mirrors add_end_of_turn_instructions tick for tick, including its guards. A
+/// threshold computed from a DIFFERENT formula than the phase actually applies
+/// would move probability mass to the wrong arm silently, which is worse than not
+/// partitioning at all. Registered in reports/c109.
+fn pending_residual_damage(state: &State, side_ref: &SideReference) -> i16 {
+    let side = state.get_side_immutable(side_ref);
+    let active = side.get_active_immutable();
+    if active.hp <= 0 {
+        return 0;
+    }
+    let mut total: i16 = 0;
+
+    // Weather. Same weather_is_active gate and same min-1 clamp as the phase.
+    if state.weather_is_active(&Weather::HAIL) {
+        if !active.has_type(&PokemonType::ICE) {
+            total += cmp::max(active.maxhp / 16, 1);
+        }
+    } else if state.weather_is_active(&Weather::SAND)
+        && !active.has_type(&PokemonType::GROUND)
+        && !active.has_type(&PokemonType::STEEL)
+        && !active.has_type(&PokemonType::ROCK)
+        && active.ability != Abilities::SANDVEIL
+    {
+        total += cmp::max(active.maxhp / 16, 1);
+    }
+
+    // Status. TOXIC scales with the counter as it stands BEFORE the phase
+    // decrements it, which is the value visible here.
+    match active.status {
+        PokemonStatus::POISON => total += cmp::max(active.maxhp / 8, 1),
+        PokemonStatus::TOXIC => {
+            let stage = cmp::max(side.side_conditions.toxic_count, 1) as i16;
+            total += cmp::max(active.maxhp / 16, 1) * stage;
+        }
+        _ => {}
+    }
+
+    // Leech Seed drains the seeded side. Liquid Ooze reverses it, so it costs the
+    // SEEDER instead and must not be counted against the seeded mon here.
+    if side
+        .volatile_statuses
+        .contains(&PokemonVolatileStatus::LEECHSEED)
+    {
+        total += cmp::max(active.maxhp / 8, 1);
+    }
+
+    cmp::min(total, active.hp)
+}
