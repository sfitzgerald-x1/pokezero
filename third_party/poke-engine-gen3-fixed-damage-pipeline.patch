+// pokezero gen3 fidelity fix (fixed-damage moves flow through the damage
+// pipeline): the fixed/level/fraction-damage arms used to apply their damage
+// directly inside choice_special_effect, and because calculate_damage returns
+// Some((0, 0)) for a zero-base-power move, check_move_hit_or_miss zeroed
+// percent_hit and the whole post-damage suite in run_move never ran: no
+// set_damage_dealt (Counter after Seismic Toss returned nothing — row
+// 1500192/91), no ability_after_damage_hit / defender-contact secondaries
+// (Rough Skin and Flame Body never fired — rows 1500103/76, 1500274/15,
+// 1500287/76), no Destiny Bond, no Endure, and Super Fang's 90% accuracy was
+// never rolled (its damage applied before the miss check). Showdown treats
+// these as ordinary damaging moves with a damageCallback (sim/battle-actions
+// getDamage:1611), so every post-damage hook runs.
+//
+// This helper computes the sim's damageCallback value; the caller substitutes
+// it for the (0, 0) placeholder so the move takes the normal damage path. A
+// Some(0) means the move fails (immunity / no stored damage) and keeps the
+// old zeroed-percent behaviour.
+fn gen3_fixed_damage_amount(
+    state: &State,
+    choice: &Choice,
+    attacking_side_ref: &SideReference,
+) -> Option<i16> {
+    // Protect's remove_effects_for_protect() zeroes category to Status; the
+    // fixed damage must not fire through Protect (verified against the sim by
+    // the Protect-fidelity sweep, patch 29 lineage).
+    if choice.category == MoveCategory::Status {
+        return None;
+    }
+    let (attacking_side, defending_side) = state.get_both_sides_immutable(attacking_side_ref);
+    let attacker = attacking_side.get_active_immutable();
+    let defender = defending_side.get_active_immutable();
+    match choice.move_id {
+        // Seismic Toss is FIGHTING-typed, but the zero-effectiveness set of
+        // Normal and of Fighting is the same single type in gen3 — Ghost.
+        Choices::SEISMICTOSS => {
+            if type_effectiveness_modifier(&PokemonType::NORMAL, defender) == 0.0 {
+                Some(0)
+            } else {
+                Some(attacker.level as i16)
+            }
+        }
+        // Night Shade dealt no damage at all before this patch (Appendix K.3);
+        // GHOST probe: Normal-types are immune.
+        Choices::NIGHTSHADE => {
+            if type_effectiveness_modifier(&PokemonType::GHOST, defender) == 0.0 {
+                Some(0)
+            } else {
+                Some(attacker.level as i16)
+            }
+        }
+        // clampIntRange(floor(hp / 2), 1) — sim data/moves.ts damageCallback.
+        // The old arm dealt hp - hp/2 (a CEILING, one high on odd hp) and dealt
+        // nothing at 1 hp where the sim deals 1.
+        Choices::SUPERFANG => {
+            if type_effectiveness_modifier(&PokemonType::NORMAL, defender) == 0.0 {
+                Some(0)
+            } else {
+                Some(cmp::max(defender.hp / 2, 1))
+            }
+        }
+        Choices::ENDEAVOR => {
+            if type_effectiveness_modifier(&PokemonType::NORMAL, defender) == 0.0
+                || attacker.hp >= defender.hp
+            {
+                Some(0)
+            } else {
+                Some(defender.hp - attacker.hp)
+            }
+        }
+        Choices::COUNTER => {
+            if defending_side.damage_dealt.move_category == MoveCategory::Physical
+                && !defender.has_type(&PokemonType::GHOST)
+            {
+                Some(defending_side.damage_dealt.damage * 2)
+            } else {
+                Some(0)
+            }
+        }
+        Choices::MIRRORCOAT => {
+            if defending_side.damage_dealt.move_category == MoveCategory::Special
+                && !defender.has_type(&PokemonType::DARK)
+            {
+                Some(defending_side.damage_dealt.damage * 2)
+            } else {
+                Some(0)
+            }
+        }
+        _ => None,
     }
 }
 
