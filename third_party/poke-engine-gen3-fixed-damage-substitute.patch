+/// Route a fixed-damage hit through a Substitute exactly as the normal damage
+/// path does (gen3/generate_instructions.rs).
+///
+/// pokezero gen3 fidelity fix: every damaging arm of `choice_special_effect`
+/// wrote its damage STRAIGHT to the Pokemon, so Seismic Toss, Super Fang,
+/// Endeavor, Counter and Mirror Coat all punched through a Substitute. None of
+/// those moves carries `bypasssub` in the gen3 data, so all five must be
+/// absorbed by the sub.
+///
+/// Showdown's rule is `substitute.onTryPrimaryHit` (data/moves.ts; gen3 adds no
+/// override): the move's own damage is computed against the POKEMON — Super Fang
+/// still halves the mon's HP, Endeavor still reads the mon's HP — and is then
+/// capped at the substitute's remaining HP:
+///
+/// ```text
+/// if (damage > target.volatiles['substitute'].hp) damage = sub.hp;
+/// sub.hp -= damage;
+/// if (sub.hp <= 0) target.removeVolatile('substitute');
+/// ```
+///
+/// so there is NO overflow onto the Pokemon when the hit exceeds the sub — the
+/// substitute simply breaks and the mon behind takes nothing. Verified against
+/// the real sim: Seismic Toss (100) into a 65 HP Substitute answers
+/// `-end <target> Substitute` with no `-damage` line on the Pokemon at all.
+fn apply_fixed_damage(
+    defending_side: &mut Side,
+    target_side_ref: SideReference,
+    damage_amount: i16,
+    instructions: &mut StateInstructions,
+) {
+    if damage_amount <= 0 {
+        return;
+    }
+    if defending_side
+        .volatile_statuses
+        .contains(&PokemonVolatileStatus::SUBSTITUTE)
+    {
+        let absorbed = cmp::min(damage_amount, defending_side.substitute_health);
+        instructions
+            .instruction_list
+            .push(Instruction::DamageSubstitute(DamageInstruction {
+                side_ref: target_side_ref,
+                damage_amount: absorbed,
+            }));
+        defending_side.substitute_health -= absorbed;
+        if defending_side.substitute_health == 0 {
+            instructions
+                .instruction_list
+                .push(Instruction::RemoveVolatileStatus(
+                    RemoveVolatileStatusInstruction {
+                        side_ref: target_side_ref,
+                        volatile_status: PokemonVolatileStatus::SUBSTITUTE,
+                    },
+                ));
+            defending_side
+                .volatile_statuses
+                .remove(&PokemonVolatileStatus::SUBSTITUTE);
+        }
+        return;
+    }
+    let dealt = cmp::min(damage_amount, defending_side.get_active_immutable().hp);
+    instructions
+        .instruction_list
+        .push(Instruction::Damage(DamageInstruction {
+            side_ref: target_side_ref,
+            damage_amount: dealt,
+        }));
+    defending_side.get_active().hp -= dealt;
+}
