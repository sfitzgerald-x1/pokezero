diff --color -ruN a/src/gen3/generate_instructions.rs b/src/gen3/generate_instructions.rs
--- a/src/gen3/generate_instructions.rs	2026-07-28 17:18:49
+++ b/src/gen3/generate_instructions.rs	2026-07-28 17:20:20
@@ -241,6 +241,50 @@
         }
     }
 
+    // pokezero gen3 fidelity fix: the Mean Look / Spider Web / Block trap is a
+    // LINKED volatile in Showdown — `addVolatile('trapped', source, move,
+    // 'trapper')` puts `trapper` on the user and `trapped` on the victim and
+    // links them, so an ORDINARY departure by the trapper runs `clearVolatile()`
+    // -> `removeLinkedVolatiles()` and frees the victim. Fainting frees it too
+    // (verified against the real sim: the victim's very next request comes back
+    // untrapped), which this covers because the faint's forced replacement runs
+    // through this same routine, at the first boundary where the victim has a
+    // choice again.
+    //
+    // A BATON PASS does NOT free the victim, and the ordering in
+    // `copyVolatileFrom` is why: the receiver copies `trapper` (gen3 inherits
+    // gen4's `noCopy: false` for BOTH `trapped` and `trapper`), then the OLD
+    // trapper's `linkedPokemon`/`linkedStatus` are DELETED, and only then does
+    // `pokemon.clearVolatile()` run — finding no link left to release. The
+    // victim's own link is meanwhile re-pointed to the receiver, so the trap
+    // simply changes owner and is released by the RECEIVER's later departure.
+    // Verified against real gen3 Showdown on the line the randbats set is built
+    // around (2 of 3 Ariados sets carry Spider Web + Baton Pass): after the
+    // trapper's pass the victim's request is still `trapped: true`, and it only
+    // comes back untrapped once the receiver itself switches out.
+    //
+    // The PARTIALLYTRAPPED release below is deliberately NOT gated the same way:
+    // Wrap/Fire Spin is not a linked volatile at all. Its release is
+    // `partiallytrapped.onResidual` checking `!source.isActive`, which is true
+    // however the source left the field — Baton Pass included.
+    if !baton_passing
+        && opposite_side
+            .volatile_statuses
+            .contains(&PokemonVolatileStatus::TRAPPED)
+    {
+        incoming_instructions
+            .instruction_list
+            .push(Instruction::RemoveVolatileStatus(
+                RemoveVolatileStatusInstruction {
+                    side_ref: switching_side_ref.get_other_side(),
+                    volatile_status: PokemonVolatileStatus::TRAPPED,
+                },
+            ));
+        opposite_side
+            .volatile_statuses
+            .remove(&PokemonVolatileStatus::TRAPPED);
+    }
+
     if opposite_side
         .volatile_statuses
         .contains(&PokemonVolatileStatus::PARTIALLYTRAPPED)
