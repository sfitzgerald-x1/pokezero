+// ---------------------------------------------------------------------------
+// Move-time immobilization markers (Attract / full paralysis)
+//
+// IN THIS FILE, NOT IN `src/state.rs`, and that placement is the whole point. The first
+// version of this patch put them in a `#[cfg(test)] mod` inside `src/state.rs`, i.e. the
+// `--lib` target -- and NOTHING in CI runs `--lib` for the engine. The workflow's engine
+// step is `cargo test --test test_gen3` with a pinned count, so three tests sitting in the
+// lib target were pins nothing executed: exactly the defect
+// `.github/workflows/engine-fidelity-gates.yml` was written to close, and the same shape as
+// the #1105 wheel break. The `SetRestSleepPendingRefund` precedent this patch follows put
+// its tests here for that reason.
+// ---------------------------------------------------------------------------
+
+fn attract_marker(side_ref: SideReference) -> Instruction {
+    Instruction::MoveImmobilized(MoveImmobilizedInstruction {
+        side_ref,
+        reason: ImmobilizeReason::Attract,
+    })
+}
+
+/// apply-then-reverse must return the state bit-identical.
+///
+/// TRIVIALLY TRUE for a pure marker, and written down anyway. The sibling
+/// `SetRestSleepPendingRefund` test carries the same name because this is the invariant
+/// that forces an Instruction variant rather than a bare mutation, and the next person to
+/// add a marker will not know which of the two cases they are in. If someone later gives
+/// this variant a state effect -- the obvious "while I am here" edit, since the reason field
+/// invites reading it back -- the no-op reverse arm stops being an inverse and this says so.
+#[test]
+fn immobilization_marker_apply_then_reverse_is_bit_identical() {
+    for reason in [ImmobilizeReason::Attract, ImmobilizeReason::Paralysis] {
+        let mut state = State::default();
+        let before = state.serialize();
+        let instruction = Instruction::MoveImmobilized(MoveImmobilizedInstruction {
+            side_ref: SideReference::SideOne,
+            reason,
+        });
+        state.apply_one_instruction(&instruction);
+        state.reverse_instructions(&vec![instruction]);
+        assert_eq!(
+            state.serialize(),
+            before,
+            "reverse must restore bit-identically for {:?}",
+            reason
+        );
+    }
+}
+
+/// APPLY ALONE must not move the state either, which is the half the apply-then-reverse
+/// test cannot see: a mutation with a matching inverse would pass that test while changing
+/// the leaf distribution the search prices, because the immobilized branch would stop being
+/// an empty delta.
+///
+/// This is the assertion the sibling refund test writes as `assert_ne!` -- the two markers
+/// differ in exactly this direction, so the pin has to be inverted rather than copied.
+#[test]
+fn immobilization_marker_apply_alone_does_not_change_the_state() {
+    for side_ref in [SideReference::SideOne, SideReference::SideTwo] {
+        for reason in [ImmobilizeReason::Attract, ImmobilizeReason::Paralysis] {
+            let mut state = State::default();
+            let before = state.serialize();
+            state.apply_one_instruction(&Instruction::MoveImmobilized(
+                MoveImmobilizedInstruction { side_ref, reason },
+            ));
+            assert_eq!(
+                state.serialize(),
+                before,
+                "the marker must be a pure no-op on apply for {:?}/{:?}",
+                side_ref,
+                reason
+            );
+        }
+    }
+}
+
+/// The marker must be DISTINGUISHABLE from the empty delta it annotates, from the other
+/// side's marker, and from the OTHER REASON. That last one is the whole mechanism:
+/// `combine_duplicate_instructions` merges branches with equal instruction lists, so two
+/// immobilizers sharing one marker value would collapse right back into the ambiguity this
+/// patch exists to remove.
+#[test]
+fn immobilization_markers_are_distinguishable_from_each_other_and_from_nothing() {
+    let attract = vec![attract_marker(SideReference::SideOne)];
+    assert_ne!(attract, Vec::<Instruction>::new());
+    assert_ne!(attract, vec![attract_marker(SideReference::SideTwo)]);
+    assert_eq!(attract, vec![attract_marker(SideReference::SideOne)]);
+    assert_ne!(
+        attract,
+        vec![Instruction::MoveImmobilized(MoveImmobilizedInstruction {
+            side_ref: SideReference::SideOne,
+            reason: ImmobilizeReason::Paralysis,
+        })],
+        "Attract and paralysis must not compare equal, or the engine merges them again"
     );
 }
+
+/// END TO END: both immobilizers mark their own branch, and the masses prove the ORDER.
+///
+/// Showdown resolves attract's onBeforeMove at priority 2 and paralysis at 1, so attract is
+/// rolled FIRST at 1/2 and paralysis only on the surviving half at 1/4 -> 1/8 overall.
+#[test]
+fn both_gen3_immobilizers_mark_their_branch_with_their_own_reason() {
+    let mut state = State::default();
+    state
+        .side_one
+        .get_active()
+        .replace_move(PokemonMoveIndex::M0, Choices::TACKLE);
+    state
+        .side_two
+        .get_active()
+        .replace_move(PokemonMoveIndex::M0, Choices::SPLASH);
+    state
+        .side_one
+        .volatile_statuses
+        .insert(PokemonVolatileStatus::ATTRACT);
+    state.side_one.get_active().status = PokemonStatus::PARALYZE;
+
+    let branches = generate_instructions_with_state_assertion(
+        &mut state,
+        &MoveChoice::Move(PokemonMoveIndex::M0),
+        &MoveChoice::Move(PokemonMoveIndex::M0),
+    );
+    let mass = |reason: ImmobilizeReason| -> f32 {
+        branches
+            .iter()
+            .filter(|b| {
+                b.instruction_list.iter().any(|i| matches!(i,
+                    Instruction::MoveImmobilized(m)
+                        if m.reason == reason && m.side_ref == SideReference::SideOne))
+            })
+            .map(|b| b.percentage)
+            .sum()
+    };
+    assert!(
+        (mass(ImmobilizeReason::Attract) - 50.0).abs() < 1e-3,
+        "attract is rolled first at 1/2: {:?}",
+        branches
+    );
+    assert!(
+        (mass(ImmobilizeReason::Paralysis) - 12.5).abs() < 1e-3,
+        "paralysis is rolled on the surviving half at 1/4: {:?}",
+        branches
+    );
+    // Every marker is TERMINAL in its branch, which is what makes the renderer's
+    // post-prelude tail exactly `[marker]`.
+    for branch in &branches {
+        if let Some(position) = branch
+            .instruction_list
+            .iter()
+            .position(|i| matches!(i, Instruction::MoveImmobilized(_)))
+        {
+            assert_eq!(
+                position,
+                branch.instruction_list.len() - 1,
+                "the marker must close the branch: {:?}",
+                branch
+            );
+        }
+    }
+}
