+#[cfg(test)]
+mod move_immobilized_marker_tests {
+    use super::*;
+    use crate::instruction::{ImmobilizeReason, Instruction, MoveImmobilizedInstruction};
+
+    fn attract_marker(side_ref: SideReference) -> Instruction {
+        Instruction::MoveImmobilized(MoveImmobilizedInstruction {
+            side_ref,
+            reason: ImmobilizeReason::Attract,
+        })
+    }
+
+    /// apply-then-reverse must return the state bit-identical.
+    ///
+    /// TRIVIALLY TRUE for a pure marker, and written down anyway. The sibling
+    /// `SetRestSleepPendingRefund` test carries the same name because this is the
+    /// invariant that forces an Instruction variant rather than a bare mutation, and
+    /// the next person to add a marker will not know which of the two cases they are
+    /// in. If someone later gives this variant a state effect -- the obvious
+    /// "while I am here" edit, since the reason field invites reading it back -- the
+    /// no-op reverse arm stops being an inverse and this test is what says so.
+    #[test]
+    fn apply_then_reverse_is_bit_identical() {
+        let mut state = State::default();
+        let before = state.serialize();
+        let instruction = attract_marker(SideReference::SideOne);
+        state.apply_one_instruction(&instruction);
+        state.reverse_instructions(&vec![instruction]);
+        assert_eq!(state.serialize(), before, "reverse must restore bit-identically");
+    }
+
+    /// APPLY ALONE must not move the state either, which is the half the
+    /// apply-then-reverse test cannot see: a mutation with a matching inverse would
+    /// pass that test while changing the leaf distribution the search prices, because
+    /// the immobilized branch would stop being an empty delta.
+    ///
+    /// This is the assertion the sibling refund test writes as `assert_ne!` -- the
+    /// two markers differ in exactly this direction, so the pin has to be inverted
+    /// rather than copied.
+    #[test]
+    fn apply_alone_does_not_change_the_state() {
+        for side_ref in [SideReference::SideOne, SideReference::SideTwo] {
+            let mut state = State::default();
+            let before = state.serialize();
+            state.apply_one_instruction(&attract_marker(side_ref));
+            assert_eq!(
+                state.serialize(),
+                before,
+                "the marker must be a pure no-op on apply for {side_ref:?}"
+            );
+        }
+    }
+
+    /// The marker must be DISTINGUISHABLE from the empty delta it annotates, which is
+    /// the entire point of the patch: an immobilized branch and a same-shaped
+    /// non-immobilized branch used to compare equal, so the renderer could not tell
+    /// "Attract stopped the move" from "full paralysis stopped the move".
+    #[test]
+    fn the_marker_is_not_equal_to_an_empty_branch_or_to_the_other_side() {
+        let branch = vec![attract_marker(SideReference::SideOne)];
+        assert_ne!(branch, Vec::<Instruction>::new());
+        assert_ne!(branch, vec![attract_marker(SideReference::SideTwo)]);
+        assert_eq!(branch, vec![attract_marker(SideReference::SideOne)]);
+    }
+}
