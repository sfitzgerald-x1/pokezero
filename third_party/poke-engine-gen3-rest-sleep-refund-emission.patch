+/// The upper bound of `rest_turns`. Not a style choice: the Rest wake `match`
+/// in `generate_instructions_from_move` enumerates 0/1/2/3 and its final arm is
+/// `panic!("Invalid rest_turns value")`, so exceeding this crashes search.
+const REST_TURNS_MAX: i8 = 3;
 
+/// pokezero gen3 fidelity fix (Rest skippedTime): apply Showdown's
+/// `slp.onBeforeMove` bookkeeping for one move attempt made while Rest-asleep.
+///
+/// ```js
+/// onBeforeMove: ... this.add('cant', pokemon, 'slp');
+///               if (move.sleepUsable) { this.effectState.skippedTime++; return; }
+///               this.effectState.skippedTime = 0;
+///               return false;
+/// ```
+/// (`data/mods/gen3/conditions.ts`, quoted in
+/// `docs/engine_divergence_ledger_20260728.md` Q.2.)
+///
+/// The discard is the half that matters: the bank dies on ANY non-`sleepUsable`
+/// attempt, not merely when the sleep stint ends. Retiring it only at stint end
+/// is strictly weaker than the real sim, and the difference is an OVER-credit --
+/// the mon sleeps a turn longer than Showdown. Reachable at depth 1 from any
+/// Rest-sleeper root: attempt a normal move, switch out, switch back in.
+fn update_rest_sleep_refund_for_attempt(
+    pkmn: &mut Pokemon,
+    sleep_usable_move: bool,
+    side_ref: SideReference,
+    pokemon_index: PokemonIndex,
+    incoming_instructions: &mut StateInstructions,
+) {
+    let previous = pkmn.rest_sleep_pending_refund;
+    // Bounded by the same domain the refund can ever be spent into, so a long
+    // Sleep Talk run cannot bank more than could legally be credited back.
+    let new_pending = if sleep_usable_move {
+        cmp::min(previous as i16 + 1, REST_TURNS_MAX as i16) as i8
+    } else {
+        0
+    };
+    if new_pending != previous {
+        incoming_instructions.instruction_list.push(
+            Instruction::SetRestSleepPendingRefund(SetSleepTurnsInstruction {
+                side_ref,
+                pokemon_index,
+                new_turns: new_pending,
+                previous_turns: previous,
+            }),
+        );
+        pkmn.rest_sleep_pending_refund = new_pending;
+    }
+}
