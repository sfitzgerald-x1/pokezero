+    // The add_remove_status_instructions void site, and getting a fixture that
+    // genuinely reaches it took three attempts -- each earlier one passed while
+    // the site's mutant stayed alive, i.e. pinned nothing:
+    //   1. Chesto Berry on Rest -- Rest zeroes the bank first, so nothing left.
+    //   2. The sleeper itself using Heal Bell -- it is asleep, so it cannot
+    //      move; the |cant| discard zeroed the bank and the cure never ran.
+    // The BENCHED sleeper is the case where the funnel is the only path: Heal
+    // Bell cures the whole party, and a benched mon makes no move attempt.
+    let mut state = State::default();
+    let benched = &mut state.side_one.pokemon[PokemonIndex::P1];
+    benched.status = PokemonStatus::SLEEP;
+    benched.rest_turns = 2;
+    benched.rest_sleep_pending_refund = 2;
+
+    let vec_of_instructions = set_moves_on_pkmn_and_call_generate_instructions(
+        &mut state,
+        Choices::HEALBELL,
+        Choices::SPLASH,
+    );
+
+    assert!(
+        vec_of_instructions.iter().any(|state_instruction| {
+            state_instruction.instruction_list.contains(
+                &Instruction::SetRestSleepPendingRefund(SetSleepTurnsInstruction {
+                    side_ref: SideReference::SideOne,
+                    pokemon_index: PokemonIndex::P1,
+                    new_turns: 0,
+                    previous_turns: 2,
+                }),
+            )
+        }),
+        "curing a benched sleeper must void its bank: {:?}",
+        vec_of_instructions
+    );
+}
+
+#[test]
+fn test_a_non_rest_sleeper_with_a_stale_bank_is_not_credited() {
+    // Pins the `status == SLEEP` clause of the switch-in guard, which was
+    // previously unpinned: an AWAKE mon carrying a bank must not be credited.
+    let mut state = State::default();
+    let pkmn = &mut state.side_one.pokemon[PokemonIndex::P1];
+    pkmn.status = PokemonStatus::NONE;
+    pkmn.rest_turns = 2;
+    pkmn.rest_sleep_pending_refund = 2;
+
+    let vec_of_instructions = generate_instructions_with_state_assertion(
+        &mut state,
+        &MoveChoice::Switch(PokemonIndex::P1),
+        &MoveChoice::None,
+    );
+
+    assert!(
+        !vec_of_instructions[0]
+            .instruction_list
+            .iter()
+            .any(|instruction| matches!(instruction, Instruction::SetRestTurns(_))),
+        "{:?}",
+        vec_of_instructions[0].instruction_list
+    );
+}
