+#[test]
+fn test_switch_in_of_a_healthy_mon_emits_nothing() {
+    // The behaviour-neutrality pin. With no refund pending -- which is every
+    // state the harness builds today -- the switch path must be byte-identical
+    // to before this change.
+    let mut state = State::default();
+
+    let vec_of_instructions = generate_instructions_with_state_assertion(
+        &mut state,
+        &MoveChoice::Switch(PokemonIndex::P1),
+        &MoveChoice::None,
+    );
+
+    assert_eq!(
+        vec_of_instructions[0].instruction_list,
+        vec![Instruction::Switch(SwitchInstruction {
+            side_ref: SideReference::SideOne,
+            previous_index: PokemonIndex::P0,
+            next_index: PokemonIndex::P1,
+        })]
+    );
+}
