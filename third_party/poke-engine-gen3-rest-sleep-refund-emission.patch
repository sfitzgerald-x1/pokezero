+#[test]
+fn test_natural_wake_voids_a_pending_rest_refund() {
+    // The stale-refund bug this guards: a refund belongs to ONE sleep stint.
+    // If waking does not void it, the mon can Rest again later in the same
+    // branch and then spend the OLD refund on switch-in -- a silent
+    // over-credit, because the switch-in consumer cannot tell a stale pending
+    // from a fresh one.
+    let mut state = State::default();
+    let pkmn = state.side_one.get_active();
+    pkmn.status = PokemonStatus::SLEEP;
+    pkmn.rest_turns = 1;
+    pkmn.rest_sleep_pending_refund = 2;
+
+    let vec_of_instructions = set_moves_on_pkmn_and_call_generate_instructions(
+        &mut state,
+        Choices::TACKLE,
+        Choices::SPLASH,
+    );
+
+    let woke = vec_of_instructions.iter().any(|state_instruction| {
+        state_instruction
+            .instruction_list
+            .contains(&Instruction::ChangeStatus(ChangeStatusInstruction {
+                side_ref: SideReference::SideOne,
+                pokemon_index: PokemonIndex::P0,
+                old_status: PokemonStatus::SLEEP,
+                new_status: PokemonStatus::NONE,
+            }))
+    });
+    assert!(woke, "the fixture must actually wake: {:?}", vec_of_instructions);
+
+    for state_instruction in &vec_of_instructions {
+        if state_instruction
+            .instruction_list
+            .iter()
+            .any(|i| matches!(i, Instruction::ChangeStatus(c) if c.new_status == PokemonStatus::NONE))
+        {
+            assert!(
+                state_instruction.instruction_list.contains(
+                    &Instruction::SetRestSleepPendingRefund(SetSleepTurnsInstruction {
+                        side_ref: SideReference::SideOne,
+                        pokemon_index: PokemonIndex::P0,
+                        new_turns: 0,
+                        previous_turns: 2,
+                    })
+                ),
+                "waking must void the refund: {:?}",
+                state_instruction.instruction_list
+            );
+        }
+    }
+}
