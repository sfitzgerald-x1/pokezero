+// pokezero gen3 fidelity fix (Rest skippedTime), the consumption half.
+//
+// Gen 3 credits a Rest sleeper's Sleep Talk/Snore-skipped turns back on
+// switch-in. The refund is carried on the mon (rest_sleep_pending_refund) and
+// spent only on the branch where a switch-in actually happens, because an
+// ACTIVE sleeper may never switch and search explores the stay-in branch too.
+//
+// Every test here goes through generate_instructions_with_state_assertion,
+// which re-serializes the state afterwards and asserts it is bit-identical --
+// so each one is also a reversibility check on the two new instructions.
+
+/// Put side one's SECOND mon (the one switched into) into a Rest sleep that has
+/// `pending` turns owed back to it.
+fn rest_sleeper_with_pending_refund(state: &mut State, rest_turns: i8, pending: i8) {
+    let pkmn = &mut state.side_one.pokemon[PokemonIndex::P1];
+    pkmn.status = PokemonStatus::SLEEP;
+    pkmn.rest_turns = rest_turns;
+    pkmn.rest_sleep_pending_refund = pending;
+}
+
+#[test]
+fn test_rest_refund_is_credited_on_switch_in() {
+    let mut state = State::default();
+    rest_sleeper_with_pending_refund(&mut state, 1, 2);
+
+    let vec_of_instructions = generate_instructions_with_state_assertion(
+        &mut state,
+        &MoveChoice::Switch(PokemonIndex::P1),
+        &MoveChoice::None,
+    );
+
+    let instructions = &vec_of_instructions[0].instruction_list;
+    assert!(
+        instructions.contains(&Instruction::SetRestTurns(SetSleepTurnsInstruction {
+            side_ref: SideReference::SideOne,
+            pokemon_index: PokemonIndex::P1,
+            new_turns: 3,
+            previous_turns: 1,
+        })),
+        "{:?}",
+        instructions
+    );
+    // Spending it must also retire it, or a second switch-in in a sibling
+    // branch would credit the same turns again.
+    assert!(
+        instructions.contains(&Instruction::SetRestSleepPendingRefund(
+            SetSleepTurnsInstruction {
+                side_ref: SideReference::SideOne,
+                pokemon_index: PokemonIndex::P1,
+                new_turns: 0,
+                previous_turns: 2,
+            }
+        )),
+        "{:?}",
+        instructions
+    );
 }
