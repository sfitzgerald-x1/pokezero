+/// The upper bound of `rest_turns`. Not a style choice: the Rest wake `match`
+/// in `generate_instructions_from_move` enumerates 0/1/2/3 and its final arm is
+/// `panic!("Invalid rest_turns value")`, so exceeding this crashes search.
+const REST_TURNS_MAX: i8 = 3;
+
+/// pokezero gen3 fidelity fix (Rest skippedTime): retire a pending Rest refund.
+///
+/// A pending refund belongs to ONE sleep stint. When that stint ends the refund
+/// has to die with it, or it is spent on an unrelated later switch-in: the
+/// switch-in consumer can only see that the mon is Rest-asleep now, and cannot
+/// tell a refund earned this stint from one left over from a previous one. The
+/// result would be a silent over-credit -- the mon sleeps longer than the real
+/// sim -- rather than a refusal or a crash.
+///
+/// Reachable without this: sleeper with a pending refund wakes while still
+/// active, uses Rest again later in the same branch, then switches.
+fn clear_rest_sleep_pending_refund(
+    pkmn: &mut Pokemon,
+    side_ref: SideReference,
+    pokemon_index: PokemonIndex,
+    incoming_instructions: &mut StateInstructions,
+) {
+    if pkmn.rest_sleep_pending_refund != 0 {
+        incoming_instructions.instruction_list.push(
+            Instruction::SetRestSleepPendingRefund(SetSleepTurnsInstruction {
+                side_ref,
+                pokemon_index,
+                new_turns: 0,
+                previous_turns: pkmn.rest_sleep_pending_refund,
+            }),
+        );
+        pkmn.rest_sleep_pending_refund = 0;
+    }
+}
