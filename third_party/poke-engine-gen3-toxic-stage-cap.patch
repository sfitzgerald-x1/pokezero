diff --color -ruN a/src/gen3/generate_instructions.rs b/src/gen3/generate_instructions.rs
--- a/src/gen3/generate_instructions.rs
+++ b/src/gen3/generate_instructions.rs
@@ -3494,7 +3494,11 @@
                         // The min-1 clamp sits INSIDE the multiply, which is a second,
                         // opposite divergence at the bottom of the HP range: a 1 HP
                         // Shedinja (in the gen3 randbats pool) takes `1 * stage`, not 1.
-                        let stage = toxic_count + 1;
+                        // Storage is i8, so normalize in i16 before every
+                        // stage/cap calculation. Malformed counters fail safe:
+                        // below zero is stage 1; 14 and above are stage 15.
+                        let normalized_toxic_count = cmp::min(cmp::max(toxic_count, 0), 14);
+                        let stage = normalized_toxic_count + 1;
                         let per_stage = cmp::max(active_pkmn.maxhp / 16, 1);
                         // Clamp against remaining HP in i32 so a deep ladder on a big
                         // maxhp cannot overflow the i16 the instruction carries.
@@ -3510,16 +3514,25 @@
                             .instruction_list
                             .push(toxic_damage_instruction);
-
+
-                        let toxic_counter_increment_instruction =
-                            Instruction::ChangeSideCondition(ChangeSideConditionInstruction {
-                                side_ref: *side_ref,
-                                side_condition: PokemonSideCondition::ToxicCount,
-                                amount: 1,
-                            });
-                        side.side_conditions.toxic_count += 1;
-                        incoming_instructions
-                            .instruction_list
-                            .push(toxic_counter_increment_instruction);
+                        let next_toxic_count = cmp::min(normalized_toxic_count + 1, 14);
+                        let mut toxic_increment = next_toxic_count - toxic_count;
+                        while toxic_increment != 0 {
+                            // Keep every emitted delta reversible: reverse_instructions
+                            // negates `amount`, so i8::MIN is deliberately excluded.
+                            let amount = cmp::min(
+                                cmp::max(toxic_increment, -(i8::MAX as i16)),
+                                i8::MAX as i16,
+                            ) as i8;
+                            incoming_instructions
+                                .instruction_list
+                                .push(Instruction::ChangeSideCondition(ChangeSideConditionInstruction {
+                                    side_ref: *side_ref,
+                                    side_condition: PokemonSideCondition::ToxicCount,
+                                    amount,
+                                }));
+                            side.side_conditions.toxic_count += amount;
+                            toxic_increment -= amount as i16;
+                        }
                     }
                     _ => {}
                 }
