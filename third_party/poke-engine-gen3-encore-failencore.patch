+/// pokezero gen3 fidelity fix: the moves whose `flags.failencore` makes Encore
+/// fail outright when they are the target's last move.
+///
+/// Resolved against gen3's ACTUAL mod chain (gen3 -> gen4 -> gen5 -> gen6 ->
+/// gen7 -> gen8 -> base `data/moves.ts`), remembering that a mod's `flags`
+/// object REPLACES its parent's wholesale rather than merging into it:
+///
+///   mimic, mirrormove, sketch, struggle   flags from data/mods/gen3/moves.ts
+///   encore, transform                     flags from data/mods/gen4/moves.ts
+///
+/// The replacement rule cuts BOTH ways, and the inverse cases are the trap here.
+/// `assist`, `metronome`, `naturepower` and `sleeptalk` all carry `failencore` in
+/// base `data/moves.ts`, but the nearest override in gen3's chain re-declares
+/// their flags WITHOUT it — assist at gen3, metronome and naturepower at gen4,
+/// sleeptalk at gen6 — so none of the four fails Encore in gen3 and none of them
+/// belongs in this list. Reading base, or gen8 (which re-adds it to sleeptalk and
+/// mirrormove), would over-fail all four.
+fn move_fails_encore(move_id: &Choices) -> bool {
+    matches!(
+        move_id,
+        Choices::ENCORE
+            | Choices::MIMIC
+            | Choices::MIRRORMOVE
+            | Choices::SKETCH
+            | Choices::STRUGGLE
+            | Choices::TRANSFORM
+    )
 }
 
