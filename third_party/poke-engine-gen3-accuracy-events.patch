+/// Push the exact numeric event onto the engine's integer0..99 accuracy draw.
+pub fn numeric_hit_count(base: f64, accuracy: i8, evasion: i8, factor: u32) -> u8 {
+    const BOOSTS: [f64; 7] = [1.0, 4.0 / 3.0, 5.0 / 3.0, 2.0, 7.0 / 3.0, 8.0 / 3.0, 3.0];
+    let a = accuracy.clamp(-6, 6);
+    let e = evasion.clamp(-6, 6);
+    let mut value = if a > 0 {
+        base * BOOSTS[a as usize]
+    } else {
+        base / BOOSTS[(-a) as usize]
+    };
+    value = if e > 0 {
+        value / BOOSTS[e as usize]
+    } else {
+        value * BOOSTS[(-e) as usize]
+    };
+    // Battle.runEvent applies its accumulated modifier only to integer relays.
+    // Keep the two staged operations in order, including their binary64 error.
+    if value >= 0.0 && value.fract() == 0.0 {
+        let product = (value as u32).wrapping_mul(factor);
+        value = ((product >> 12) + (((product & 4095) + 2047) >> 12)) as f64;
+    }
+    value.ceil().clamp(0.0, 100.0) as u8
+}
