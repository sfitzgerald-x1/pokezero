+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::choices::MOVES;
+    #[test]
+    fn pinned_all_102414_numeric_event_cells() {
+        // Golden produced by real pinned Showdown events, not Rust arithmetic.
+        let mut h = 14695981039346656037u64;
+        for factor in [4096, 3277, 2621, 5324, 4258, 3276] {
+            for base in 0..=100 {
+                for a in -6..=6 {
+                    for e in -6..=6 {
+                        h = (h ^ numeric_hit_count(base as f64, a, e, factor) as u64)
+                            .wrapping_mul(1099511628211);
+                    }
+                }
+            }
+        }
+        assert_eq!(h, 2167418599060954774u64);
+    }
+    #[test]
+    fn source_integer_fractional_and_ieee_boundaries() {
+        assert_eq!(numeric_hit_count(100.0, 0, 0, 3277), 80);
+        assert_eq!(numeric_hit_count(100.0, -4, 0, 3277), 43);
+        assert_eq!(numeric_hit_count(50.0, 1, 1, 3277), 50);
+        assert_eq!(numeric_hit_count(85.0, 1, 2, 3277), 54);
+        assert_eq!(numeric_hit_count(80.0, 2, 5, 4096), 51);
+        assert_eq!(numeric_hit_count(75.0, 0, 0, 5324), 97);
+    }
+    #[test]
+    fn type_status_always_hit_weather_and_current_abilities() {
+        let mut s = State::default();
+        s.side_one.get_active().ability = Abilities::HUSTLE;
+        let side = SideReference::SideOne;
+        assert_eq!(
+            resolve(&s, MOVES.get(&Choices::AERIALACE).unwrap(), &side),
+            100.0
+        );
+        assert_eq!(
+            resolve(&s, MOVES.get(&Choices::TOXIC).unwrap(), &side),
+            68.0
+        );
+        s.side_one.accuracy_boost = -4;
+        assert_eq!(
+            resolve(&s, MOVES.get(&Choices::HIDDENPOWERICE70).unwrap(), &side),
+            43.0
+        );
+        s.weather.weather_type = Weather::RAIN;
+        s.side_two.evasion_boost = 6;
+        assert_eq!(
+            resolve(&s, MOVES.get(&Choices::THUNDER).unwrap(), &side),
+            100.0
+        );
+        s.side_two.get_active().ability = Abilities::CLOUDNINE;
+        assert_ne!(
+            resolve(&s, MOVES.get(&Choices::THUNDER).unwrap(), &side),
+            100.0
+        );
+        s.side_one.accuracy_boost = 0;
+        s.side_two.evasion_boost = 0;
+        s.side_one.get_active().ability = Abilities::COMPOUNDEYES;
+        s.side_two.get_active().ability = Abilities::SANDVEIL;
+        s.weather.weather_type = Weather::SAND;
+        assert_eq!(
+            resolve(&s, MOVES.get(&Choices::TOXIC).unwrap(), &side),
+            88.0
+        );
+    }
+}
