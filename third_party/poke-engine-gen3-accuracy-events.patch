+/// Called once after move/weather/ability resolution, before charge/Protect
+/// rewrites that intentionally replace or preserve the resolved accuracy.
+pub fn resolve(state: &State, choice: &Choice, side: &SideReference) -> f32 {
+    // Existing immunity/crash failure rewrites own their explicit zero.
+    if choice.accuracy <= 0.0 {
+        return 0.0;
+    }
+    if always_hit(choice.move_id)
+        || (choice.move_id == Choices::THUNDER && state.weather_is_active(&Weather::RAIN))
+    {
+        return 100.0;
+    }
+    let (own, foe) = state.get_both_sides_immutable(side);
+    let p = own.get_active_immutable();
+    let q = foe.get_active_immutable();
+    let physical_type = matches!(
+        choice.move_type,
+        PokemonType::NORMAL
+            | PokemonType::FIGHTING
+            | PokemonType::FLYING
+            | PokemonType::POISON
+            | PokemonType::GROUND
+            | PokemonType::ROCK
+            | PokemonType::BUG
+            | PokemonType::GHOST
+            | PokemonType::STEEL
+    );
+    // Gen3 inherits gen4 scalar chainModify(1.3/0.8): trunc5324/3276,
+    // unlike Hustle's explicit3277/4096 fraction.
+    let attack = if p.ability == Abilities::COMPOUNDEYES {
+        5324
+    } else if p.ability == Abilities::HUSTLE && physical_type {
+        3277
+    } else {
+        4096
+    };
+    let defend = if q.ability == Abilities::SANDVEIL && state.weather_is_active(&Weather::SAND) {
+        3276
+    } else {
+        4096
+    };
+    let factor = (attack * defend + 2048) >> 12;
+    numeric_hit_count(
+        choice.accuracy as f64,
+        own.accuracy_boost,
+        foe.evasion_boost,
+        factor,
+    ) as f32
+}
