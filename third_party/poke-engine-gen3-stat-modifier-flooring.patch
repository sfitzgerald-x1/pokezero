+// pokezero gen3 fidelity fix (stat-modifier flooring): RSE applies the
+// item/ability stat modifiers to the (already boost-floored) STAT via
+// `battle.modify`'s 4096-based fixed point BEFORE the base formula's /Defense
+// and /50 truncations. `getDamage` (sim/battle-actions.ts) computes
+// `attack = attacker.calculateStat(...)` and then fires the
+// ModifyAtk/ModifySpA/ModifyDef/ModifySpD events; every gen3 handler
+// (data/mods/gen3/items.ts for Choice Band / Light Ball / Thick Club /
+// Soul Dew / the 1.1x type items, data/abilities.ts for Guts / Huge Power /
+// Pure Power / Hustle / Marvel Scale, base data/items.ts for Metal Powder)
+// calls `chainModify`; the event tail applies ONE `modify()` with the
+// accumulated modifier (sim/battle.ts runEvent -> modify). Upstream instead
+// multiplied `choice.base_power` in f32, which carries the modifier's
+// half-point through the /D and /50 floors: a Choice Band on an odd attack
+// stat left the engine's max roll 1-2 points above the sim's, so the sim's
+// real bottom rolls fell outside the engine's legal roll set (the c9
+// `mechanism2_stat_modifier_flooring` family; proof rows 1500024/9 and
+// 1500221/13 in the divergence ledger).
+//
+// `battle.modify(v, m)`: tr((tr(v * tr(m*4096)) + 2048 - 1) / 4096) — a
+// round-half-down at 4096 scale. `chainModify` accumulates
+// (prev * next + 2048) >> 12. Both transcribed from sim/battle.ts:2318-2359.
+const FP_ONE: i32 = 4096;
+const FP_1_05: i32 = 4300; // tr(1.05 * 4096) — Sea Incense (mods/gen3/items.ts)
+const FP_1_1: i32 = 4505; // tr(1.1 * 4096) — the gen3 type-boost items
+const FP_1_5: i32 = 6144;
+const FP_2: i32 = 8192;
+
+fn fp_chain(previous: i32, next: i32) -> i32 {
+    (previous * next + 2048) >> 12
+}
+
+fn fp_modify(value: i32, modifier: i32) -> i32 {
+    (value * modifier + 2048 - 1) >> 12
+}
+
+/// ModifyAtk / ModifySpA: the attacker-side stat modifiers, chained in the
+/// sim's handler-priority order (abilities at priority 5, items at 1,
+/// Plus/Minus at 0 — sim comparePriority runs HIGHER priority first).
+fn gen3_offensive_stat_modifiers(
+    stat: i16,
+    attacking_side: &Side,
+    defending_side: &Side,
+    choice: &Choice,
+) -> i16 {
+    let attacker = attacking_side.get_active_immutable();
+    let defender = defending_side.get_active_immutable();
+    let mut stat = stat as i32;
+    let mut chain = FP_ONE;
+    match choice.category {
+        MoveCategory::Physical => {
+            match attacker.ability {
+                // Guts keys off the status at damage time (onModifyAtk), which
+                // this function reads live: on the engine's wake/thaw branch the
+                // status is already NONE before the damage instruction is
+                // generated, and a Sleep Talk-called move still carries SLEEP —
+                // both match Showdown's evaluation point. Burn gets no special
+                // case here: the stepwise pipeline's Guts-guarded burn halving
+                // (below, in common_pkmn_damage_calc) is the only burn term the
+                // sim has for a Guts attacker.
+                Abilities::GUTS if attacker.status != PokemonStatus::NONE => {
+                    chain = fp_chain(chain, FP_1_5);
+                }
+                Abilities::HUGEPOWER | Abilities::PUREPOWER => {
+                    chain = fp_chain(chain, FP_2);
+                }
+                // Hustle is the one handler that modifies the stat DIRECTLY
+                // ("applied directly to the stat as opposed to chaining with the
+                // others" — data/abilities.ts), so it takes its own floor before
+                // the chained handlers' single final modify.
+                Abilities::HUSTLE => {
+                    stat = fp_modify(stat, FP_1_5);
+                }
+                _ => {}
+            }
+            match attacker.item {
+                Items::CHOICEBAND => chain = fp_chain(chain, FP_1_5),
+                Items::THICKCLUB => match attacker.id {
