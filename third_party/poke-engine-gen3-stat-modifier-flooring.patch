+                // gen3's physical types (the hook name IS the category gate).
+                Items::SILKSCARF if choice.move_type == PokemonType::NORMAL => {
+                    chain = fp_chain(chain, FP_1_1);
+                }
+                Items::BLACKBELT if choice.move_type == PokemonType::FIGHTING => {
+                    chain = fp_chain(chain, FP_1_1);
+                }
+                Items::SHARPBEAK if choice.move_type == PokemonType::FLYING => {
+                    chain = fp_chain(chain, FP_1_1);
+                }
+                Items::POISONBARB if choice.move_type == PokemonType::POISON => {
+                    chain = fp_chain(chain, FP_1_1);
+                }
+                Items::SOFTSAND if choice.move_type == PokemonType::GROUND => {
+                    chain = fp_chain(chain, FP_1_1);
+                }
+                Items::HARDSTONE if choice.move_type == PokemonType::ROCK => {
+                    chain = fp_chain(chain, FP_1_1);
+                }
+                Items::SILVERPOWDER if choice.move_type == PokemonType::BUG => {
+                    chain = fp_chain(chain, FP_1_1);
+                }
+                Items::SPELLTAG if choice.move_type == PokemonType::GHOST => {
+                    chain = fp_chain(chain, FP_1_1);
+                }
+                Items::METALCOAT if choice.move_type == PokemonType::STEEL => {
+                    chain = fp_chain(chain, FP_1_1);
+                }
+                _ => {}
+            }
+        }
+        MoveCategory::Special => {
+            match attacker.item {
+                // gen3 Light Ball doubles SpA ONLY (mods/gen3/items.ts kills the
+                // inherited onModifyAtk/onBasePower); the physical doubling
+                // upstream carried is a gen4+ behaviour.
+                Items::LIGHTBALL if attacker.id.is_pikachu_variant() => {
+                    chain = fp_chain(chain, FP_2);
+                }
+                Items::SOULDEW => match attacker.id {
+                    PokemonName::LATIOS | PokemonName::LATIAS => {
+                        chain = fp_chain(chain, FP_1_5);
+                    }
+                    _ => {}
+                },
+                Items::CHOICESPECS => chain = fp_chain(chain, FP_1_5),
+                Items::MYSTICWATER if choice.move_type == PokemonType::WATER => {
+                    chain = fp_chain(chain, FP_1_1);
+                }
+                Items::SEAINCENSE if choice.move_type == PokemonType::WATER => {
+                    chain = fp_chain(chain, FP_1_05);
+                }
+                Items::CHARCOAL if choice.move_type == PokemonType::FIRE => {
+                    chain = fp_chain(chain, FP_1_1);
+                }
+                Items::MAGNET if choice.move_type == PokemonType::ELECTRIC => {
+                    chain = fp_chain(chain, FP_1_1);
+                }
+                Items::MIRACLESEED if choice.move_type == PokemonType::GRASS => {
+                    chain = fp_chain(chain, FP_1_1);
+                }
+                Items::NEVERMELTICE if choice.move_type == PokemonType::ICE => {
+                    chain = fp_chain(chain, FP_1_1);
+                }
+                Items::TWISTEDSPOON if choice.move_type == PokemonType::PSYCHIC => {
+                    chain = fp_chain(chain, FP_1_1);
+                }
+                Items::BLACKGLASSES if choice.move_type == PokemonType::DARK => {
+                    chain = fp_chain(chain, FP_1_1);
+                }
+                // Dragon Fang boosts; Dragon Scale is a bare evolution item in
+                // the sim (no hooks) — upstream's 1.1 on it was invented.
+                Items::DRAGONFANG if choice.move_type == PokemonType::DRAGON => {
+                    chain = fp_chain(chain, FP_1_1);
+                }
+                _ => {}
+            }
+            // gen3 Plus/Minus check ALL actives (mods/gen3/abilities.ts uses
+            // getAllActive, not allies()), so the boost fires across the field
+            // in singles: a Minun facing a Plusle is boosted, and vice versa.
+            match attacker.ability {
+                Abilities::PLUS if defender.ability == Abilities::MINUS => {
+                    chain = fp_chain(chain, FP_1_5);
+                }
+                Abilities::MINUS if defender.ability == Abilities::PLUS => {
+                    chain = fp_chain(chain, FP_1_5);
+                }
+                _ => {}
+            }
+        }
+        _ => {}
+    }
+    fp_modify(stat, chain) as i16
+}
+
+/// ModifyDef / ModifySpD, plus the gen<=4 Explosion/Self-Destruct defense
+/// halving, which `getDamage` applies to the MODIFIED defense stat:
+/// `clampIntRange(floor(defense / 2), 1)` (sim/battle-actions.ts).
+fn gen3_defensive_stat_modifiers(
+    stat: i16,
+    defending_side: &Side,
+    choice: &Choice,
+) -> i16 {
+    let defender = defending_side.get_active_immutable();
+    let mut chain = FP_ONE;
+    match choice.category {
+        MoveCategory::Physical => {
+            if defender.ability == Abilities::MARVELSCALE
+                && defender.status != PokemonStatus::NONE
+            {
+                chain = fp_chain(chain, FP_1_5);
+            }
+            // Metal Powder is x2 Defense for an UNTRANSFORMED Ditto (base
+            // data/items.ts, unmodified through the gen3 chain); upstream's
+            // any-category /1.5 was both the wrong factor and the wrong scope.
+            if defender.item == Items::METALPOWDER
+                && defender.id == PokemonName::DITTO
+                && defender.pre_transform.is_none()
+            {
+                chain = fp_chain(chain, FP_2);
+            }
+        }
+        MoveCategory::Special => {
+            if defender.item == Items::SOULDEW {
+                match defender.id {
+                    PokemonName::LATIOS | PokemonName::LATIAS => {
+                        chain = fp_chain(chain, FP_1_5);
+                    }
+                    _ => {}
+                }
+            }
+        }
+        _ => {}
+    }
+    let mut stat = fp_modify(stat as i32, chain);
+    if choice.category == MoveCategory::Physical
+        && matches!(choice.move_id, Choices::EXPLOSION | Choices::SELFDESTRUCT)
+    {
+        stat = (stat / 2).max(1);
+    }
+    stat as i16
