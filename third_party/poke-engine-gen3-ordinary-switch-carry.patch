+/// Raw actions0..3 are move slots;4..8 enumerate inactive party slots.
+/// This API never invokes the public species/move string parser.
+fn action(side: &Side, slot: u8) -> Result<MoveChoice, &'static str> {
+    if slot < 4 {return Ok(MoveChoice::Move(move_index(slot)?));}
+    if slot > 8 {return Err("ORDINARY_EXACT_SLOT_REQUIRED");}
+    let target=pokemon_index_iter().filter(|p| *p != side.active_index)
+        .nth((slot-4) as usize).ok_or("ORDINARY_EXACT_SLOT_REQUIRED")?;
+    if side.pokemon[target].hp <= 0 {return Err("STEP_ILLEGAL_SWITCH");}
+    Ok(MoveChoice::Switch(target))
+}
+
+fn admitted_participant(mon: &Pokemon) -> bool {
+    matches!(mon.ability, Abilities::NONE | Abilities::STATIC | Abilities::PRESSURE
+        | Abilities::LEVITATE | Abilities::CLOUDNINE | Abilities::FLASHFIRE | Abilities::MAGMAARMOR)
+        && matches!(mon.item, Items::NONE | Items::LEFTOVERS | Items::LIGHTBALL | Items::CHOICEBAND)
+        && matches!(mon.status, PokemonStatus::NONE | PokemonStatus::POISON | PokemonStatus::PARALYZE | PokemonStatus::BURN)
+        && mon.pre_transform.is_none() && mon.rest_sleep_pending_refund == 0
+        && mon.rest_turns == 0 && mon.sleep_turns == 0 && !mon.terastallized
+}
