+            let switches:Vec<_>=branches[0].instructions.instruction_list.iter().filter_map(|i|
+                if let Instruction::Switch(v)=i {Some(v.side_ref)} else {None}).collect();
+            assert_eq!(switches.len(),2);assert_eq!(switches[0],if coin==0 {SideReference::SideOne} else {SideReference::SideTwo});
