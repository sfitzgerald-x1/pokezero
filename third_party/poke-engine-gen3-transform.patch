+/// pokezero gen3 fidelity fix (Transform): the transformer's own base form,
+/// captured the moment it first Transforms and read back when it leaves the
+/// field.
+///
+/// Only the fields Transform overwrites that are NOT already recoverable from
+/// somewhere else live here. Deliberately absent:
+///   * types    -> `Pokemon::base_types` (restored by the TYPECHANGE switch-out arm)
+///   * ability  -> `Pokemon::base_ability` (restored by `ability_on_switch_out`)
+///   * boosts   -> zeroed by `reset_boosts` on switch-out
+///   * disabled -> cleared by `re_enable_disabled_moves` on switch-out
+///   * hp/maxhp/status -> Transform never touches them
+///
+/// It is boxed and optional so an untransformed Pokemon costs one null pointer
+/// and zero allocations; only the (rare) transformed Pokemon pays.
+#[derive(Debug, Clone, PartialEq)]
+pub struct PreTransform {
+    pub id: PokemonName,
+    pub attack: i16,
+    pub defense: i16,
+    pub special_attack: i16,
+    pub special_defense: i16,
+    pub speed: i16,
+    /// (move id, current pp) per slot, in M0..M3 order.
+    pub moves: [(Choices, i8); 4],
+}
+
+impl PreTransform {
+    /// Snapshot a Pokemon that is currently in its base form.
+    pub fn capture(pkmn: &Pokemon) -> PreTransform {
+        PreTransform {
+            id: pkmn.id,
+            attack: pkmn.attack,
+            defense: pkmn.defense,
+            special_attack: pkmn.special_attack,
+            special_defense: pkmn.special_defense,
+            speed: pkmn.speed,
+            moves: [
+                (pkmn.moves.m0.id, pkmn.moves.m0.pp),
+                (pkmn.moves.m1.id, pkmn.moves.m1.pp),
+                (pkmn.moves.m2.id, pkmn.moves.m2.pp),
+                (pkmn.moves.m3.id, pkmn.moves.m3.pp),
+            ],
+        }
+    }
+
+    pub fn serialize(&self) -> String {
+        format!(
+            "{};{};{};{};{};{};{}:{};{}:{};{}:{};{}:{}",
+            self.id,
+            self.attack,
+            self.defense,
+            self.special_attack,
+            self.special_defense,
+            self.speed,
+            self.moves[0].0.to_string(),
+            self.moves[0].1,
+            self.moves[1].0.to_string(),
+            self.moves[1].1,
+            self.moves[2].0.to_string(),
+            self.moves[2].1,
+            self.moves[3].0.to_string(),
+            self.moves[3].1,
+        )
+    }
+
+    pub fn deserialize(serialized: &str) -> PreTransform {
+        let split: Vec<&str> = serialized.split(";").collect();
+        let mut moves = [(Choices::NONE, 0i8); 4];
+        for (index, slot) in moves.iter_mut().enumerate() {
+            let mut parts = split[6 + index].split(":");
+            slot.0 = Choices::from_str(parts.next().unwrap()).unwrap();
+            slot.1 = parts.next().unwrap().parse::<i8>().unwrap();
+        }
+        PreTransform {
+            id: PokemonName::from_str(split[0]).unwrap(),
+            attack: split[1].parse::<i16>().unwrap(),
+            defense: split[2].parse::<i16>().unwrap(),
+            special_attack: split[3].parse::<i16>().unwrap(),
+            special_defense: split[4].parse::<i16>().unwrap(),
+            speed: split[5].parse::<i16>().unwrap(),
+            moves,
+        }
+    }
+}
