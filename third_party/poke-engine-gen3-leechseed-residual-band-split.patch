+    /// Band `index`'s half-open damage window `[t_i, t_i+1)`.
+    ///
+    /// The upper bound is the next threshold up, or the partition's ceiling for
+    /// the top band -- exactly the interval whose population
+    /// `residual_disjoint_bands` stored as that band's roll count, so a caller
+    /// enumerating the window recovers the same rolls the count was derived
+    /// from. `bands` is ascending after the `reverse()` below, which is what
+    /// makes "the next entry" the next threshold up.
+    fn band_window(&self, index: usize) -> (i16, i16) {
+        let (threshold, _) = self.bands[index];
+        let upper = if index + 1 < self.len {
+            self.bands[index + 1].0
+        } else {
+            self.ceiling
+        };
+        (threshold, upper)
+    }
