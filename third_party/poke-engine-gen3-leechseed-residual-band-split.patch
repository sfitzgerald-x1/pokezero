+/// pokezero gen3 fidelity fix (G8, roll-dependent Leech Seed drain).
+///
+/// Replace ONE residual-kill arm priced at its band's threshold with one arm per
+/// roll inside that band, each at `arm_chance`.
+///
+/// Why only here. A residual that KILLS is capped by the HP that happened to be
+/// left, so its magnitude inherits the damage roll -- and when that residual is
+/// Leech Seed the capped amount is TRANSFERRED, arriving on the other side as a
+/// bare `heal` the comparator checks EXACTLY. Over a lethal band the drain
+/// `min(maxhp/8, hp_after_move + leftovers)` is injective in the roll, so a
+/// single arm at the threshold prices exactly one of the band's rolls and the
+/// rest have no arm at all (reports/c140 section 6a, ledger G8). Splitting the
+/// band restores an arm at every drain the band can produce.
+///
+/// Returns `false` -- having pushed NOTHING -- when the integer fan does not put
+/// exactly `expected_rolls` of its sixteen slots inside `[lower, upper)`, so the
+/// caller can emit the single collapsed arm and keep the band's mass at
+/// `expected_rolls / 16` regardless. The count check runs BEFORE any push for
+/// exactly that reason: a partial emission would leave the fallback arm
+/// double-counting the rolls already pushed.
+///
+/// That disagreement is a REACHABLE path, not a theoretical one. `expected_rolls`
+/// comes from `compare_health_with_damage_multiples`'s f32 accumulator and the
+/// enumeration here is exact integer arithmetic; reproducing both counters over
+/// `max_damage` in `10..=600` and every threshold above the f32 fan's floor,
+/// 288 of 27,318 `(max, threshold)` windows disagree -- 1.054 %, touching 256 of
+/// the 591 `max_damage` values. On each of those the band keeps today's behaviour
+/// exactly.
+fn push_per_roll_residual_kill_arms(
+    fan: &[i16; 16],
+    lower: i16,
+    upper: i16,
+    expected_rolls: i16,
+    arm_chance: f32,
+    incoming_instructions: &StateInstructions,
+    extra_branches: &mut Vec<(StateInstructions, i16)>,
+) -> bool {
+    let in_band = |roll: &i16| *roll >= lower && *roll < upper;
+    if fan.iter().filter(|roll| in_band(roll)).count() as i16 != expected_rolls {
+        return false;
     }
+    for roll in fan.iter().filter(|roll| in_band(roll)) {
+        let mut arm = incoming_instructions.clone();
+        arm.update_percentage(arm_chance);
+        extra_branches.push((arm, *roll));
+    }
+    true
 }
 
