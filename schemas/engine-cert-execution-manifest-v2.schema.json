{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "engine-cert-execution-manifest-v2.schema.json",
  "title": "File-backed engine certification execution manifest",
  "type": "object",
  "required": ["schema", "producer", "source", "contract_blob", "readout_blob", "engine_provenance", "aggregate_provenance", "shards"],
  "properties": {
    "schema": {"const": "engine-cert-execution-manifest/2"},
    "producer": {"$ref": "#/$defs/file"},
    "source": {
      "type": "object",
      "required": ["commit", "checkout"],
      "properties": {
        "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "checkout": {"type": "string", "minLength": 1}
      }
    },
    "contract_blob": {"$ref": "#/$defs/file"},
    "readout_blob": {"$ref": "#/$defs/file"},
    "engine_provenance": {
      "type": "object",
      "required": ["fingerprint", "stamp"],
      "properties": {
        "fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "stamp": {"$ref": "#/$defs/file"}
      }
    },
    "aggregate_provenance": {"$ref": "#/$defs/aggregate_probes"},
    "shards": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["seed_start", "report", "checkpoint", "completion_marker", "image_commit", "behavioral_probes", "branch_events_probe"],
        "properties": {
          "seed_start": {"type": "integer", "minimum": 0},
          "report": {"$ref": "#/$defs/file"},
          "checkpoint": {"$ref": "#/$defs/checkpoint"},
          "completion_marker": {"$ref": "#/$defs/file"},
          "image_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
          "behavioral_probes": {"$ref": "#/$defs/behavioral_probe"},
          "branch_events_probe": {"$ref": "#/$defs/branch_probe"}
        }
      }
    }
  },
  "$defs": {
    "file": {
      "type": "object",
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "behavioral_probe": {
      "allOf": [
        {"$ref": "#/$defs/file"},
        {"type": "object", "required": ["passed", "total"], "properties": {"passed": {"type": "integer", "minimum": 0}, "total": {"type": "integer", "minimum": 0}}}
      ]
    },
    "branch_probe": {
      "allOf": [
        {"$ref": "#/$defs/file"},
        {"type": "object", "required": ["passed"], "properties": {"passed": {"type": "boolean"}}}
      ]
    },
    "aggregate_probes": {
      "type": "object",
      "required": ["behavioral_probes", "branch_events_probe"],
      "properties": {
        "behavioral_probes": {"$ref": "#/$defs/behavioral_probe"},
        "branch_events_probe": {"$ref": "#/$defs/branch_probe"}
      }
    },
    "checkpoint": {
      "allOf": [
        {"$ref": "#/$defs/file"},
        {"type": "object", "required": ["records", "resume_provenance"], "properties": {"records": {"type": "integer", "minimum": 1}, "resume_provenance": {"type": "object", "required": ["source_commit", "engine_fingerprint", "image_commit"], "properties": {"source_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"}, "engine_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "image_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"}}}}}
      ]
    }
  }
}
