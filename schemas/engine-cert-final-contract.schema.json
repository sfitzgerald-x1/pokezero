{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "engine-cert-final-contract.schema.json",
  "title": "Public final engine certification contract",
  "type": "object",
  "required": ["registered_before_launch", "requires_execution_contract", "certification_gates", "pre_registered_family_rate_table", "predicted_class_rates_10k", "launch_registration"],
  "properties": {
    "registered_before_launch": {"const": true},
    "requires_execution_contract": {"const": true},
    "certification_gates": {
      "type": "object",
      "required": ["expected_shards", "expected_games", "seed_blocks", "minimum_coverage_measured_fraction", "required_build_check", "required_matcher", "required_repros_per_game", "required_keep_repro", "required_behavioral_probe_passes", "required_source_commit", "required_image_commit", "required_engine_fingerprint", "required_readout_sha256", "required_execution_manifest_producer_sha256"],
      "properties": {
        "expected_shards": {"type": "integer", "minimum": 1},
        "expected_games": {"type": "integer", "minimum": 1},
        "seed_blocks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["start", "games"],
            "properties": {
              "start": {"type": "integer", "minimum": 0},
              "games": {"type": "integer", "minimum": 1}
            }
          }
        },
        "minimum_coverage_measured_fraction": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
        "required_build_check": {"type": "string", "minLength": 1},
        "required_matcher": {"type": "string", "minLength": 1},
        "required_repros_per_game": {"type": "integer", "minimum": 0},
        "required_keep_repro": {"type": "integer", "minimum": 0},
        "required_behavioral_probe_passes": {"type": "integer", "minimum": 1},
        "required_source_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "required_image_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "required_engine_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "required_readout_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "required_execution_manifest_producer_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "pre_registered_family_rate_table": {
      "type": "object",
      "required": ["documented_families", "new_mechanisms_post_fix"],
      "properties": {
        "documented_families": {"type": "object"},
        "new_mechanisms_post_fix": {"type": "object"}
      }
    },
    "predicted_class_rates_10k": {"type": "object"},
    "launch_registration": {
      "type": "object",
      "required": ["fresh_measurements_inspected_before_registration", "coordinator_go", "engine_patch_count"],
      "properties": {
        "fresh_measurements_inspected_before_registration": {"const": 0},
        "coordinator_go": {"const": true},
        "engine_patch_count": {"type": "integer", "minimum": 1}
      }
    }
  }
}
